// 主题全局：亮暗两套调色板，dark 由 Rust 侧根据系统/用户设置注入
export global ThemeG {
    in-out property <bool> dark: false;

    in-out property <color> bg: dark ? #121417 : #f5f6f8;
    in-out property <color> panel: dark ? #191c21 : #ffffff;
    in-out property <color> panel-2: dark ? #21252c : #f0f1f4;
    in-out property <color> border: dark ? #2a2f38 : #e2e4e9;
    in-out property <color> text: dark ? #e8eaed : #1c1e22;
    in-out property <color> text-dim: dark ? #99a0ac : #6b7280;
    in-out property <color> accent: dark ? #5b95ff : #2563eb;
    in-out property <color> accent-soft: dark ? #5b95ff22 : #2563eb16;
    in-out property <color> ok: dark ? #4ade80 : #16a34a;
    in-out property <color> warn: dark ? #fbbf24 : #d97706;
    in-out property <color> err: dark ? #f87171 : #dc2626;
    in-out property <color> hover: dark ? #ffffff12 : #0000000d;
    in-out property <color> pressed: dark ? #ffffff1c : #00000014;

    in-out property <length> radius: 10px;
    in-out property <length> radius-s: 6px;
}
