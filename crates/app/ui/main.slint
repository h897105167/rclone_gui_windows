import { ThemeG } from "theme.slint";
export { ThemeG }
import { LineEdit, ComboBox, ListView, ScrollView, CheckBox, TextEdit } from "std-widgets.slint";

// ---------------- 数据结构 ----------------

export struct XferRow {
    name: string,
    size: string,
    speed: string,
    percent: int,
}
export struct FileRow {
    name: string,
    is-dir: bool,
    size: string,
    mtime: string,
}
export struct MountRow {
    fs: string,
    mount-point: string,
    pending: bool,
}
export struct PluginRow {
    id: string,
    name: string,
    version: string,
    desc: string,
    loaded: bool,
    enabled: bool,
}
export struct RootRow {
    id: string,
    remote: string,
    is-default: bool,
    public-template: string,
}
export struct TokenRow {
    id: string,
    name: string,
    token: string,
    created: string,
}
export struct ImageRow {
    name: string,
    path: string,
    url: string,
    size: string,
    sha1: string,
    uploaded: string,
}
export struct RemoteRow {
    name: string,
    rtype: string,
    usage: string,
}
export struct FieldRow {
    name: string,
    label: string,
    kind: string,       // "text" | "password" | "bool" | "number" | "select"
    value: string,      // bool 为 "true"/"false"，select 为当前选中值
    required: bool,
    help: string,
    is-advanced: bool,
    options: string,    // select 类型的选项，逗号分隔
}
export struct ServeRow {
    id: string,
    name: string,
    stype: string,
    fs: string,
    addr: string,
}
export struct PathItem {
    name: string,
    is-dir: bool,
}
export struct TaskRow {
    id: int,
    op: string,
    remote: string,
    path: string,
    svc: string,
    status: string,
    duration: string,
    speed: string,
    done: bool,
}

// ---------------- 全局状态 ----------------

export global NavG {
    in-out property <int> idx: 0;
    // 启动预热进行中（侧边栏"远程"图标显示 spinner，不遮挡输入）
    in-out property <bool> starting: false;
}

export global ToastG {
    in-out property <bool> show: false;
    in-out property <string> msg: "";
    in-out property <int> kind: 0; // 0 info 1 ok 2 err
}

// busy 状态帧驱动（Spinner 动画，Rust 侧定时器推进）
export global BusyG {
    in-out property <int> frame: 0;
}

// 远程路径浏览弹窗
export global BrowseG {
    in-out property <bool> show: false;
    in-out property <int> scope: 0;      // 0 挂载 / 1 服务
    in-out property <string> path: "root://";
    in-out property <[PathItem]> entries: [];
    in-out property <int> sel: -1;       // 当前高亮选中行
}

export global DashboardG {
    in-out property <string> version: "—";
    in-out property <string> os-info: "—";
    in-out property <bool> running: false;
    in-out property <bool> managed: true;
    in-out property <string> url: "";
    in-out property <int> remotes: 0;
    in-out property <string> speed: "0 B/s";
    in-out property <string> total-bytes: "0 B";
    in-out property <int> transfers: 0;
    in-out property <[XferRow]> xfers: [];
    in-out property <int> mounts: 0;
    in-out property <int> errors: 0;
}

export global FilesG {
    in-out property <[string]> remotes: [];
    in-out property <int> remote-idx: 0;
    in-out property <string> path: "";
    in-out property <[FileRow]> entries: [];
    // 目录请求进行中：禁点文件 + spinner，成功后才更新路径
    in-out property <bool> loading: false;
    // 请求序号：新请求递增，旧请求的迟到结果按序号丢弃
    in-out property <int> seq: 0;
    in-out property <int> sel: -1;
    in-out property <string> rename-name: "";
}

export global MountsG {
    in-out property <[MountRow]> mounts: [];
    in-out property <string> new-fs: "root://";
    // 远程路径历史记录（最多 10 条，最新在前）
    in-out property <[string]> history: [];
    in-out property <string> new-point: "*";
    in-out property <bool> ro: false;
    in-out property <[string]> caches: ["off", "minimal", "writes", "full"];
    in-out property <int> cache-idx: 2;
    in-out property <bool> auto-mount: true;
    in-out property <bool> winfsp-ok: false;
    in-out property <string> winfsp-msg: "";
    in-out property <bool> busy: false;
    in-out property <string> search: "";
}

export global PluginsG {
    in-out property <[PluginRow]> rows: [];
    in-out property <bool> loaded: false;
    // 当前展开的插件索引（-1 全部收起）
    in-out property <int> expanded: -1;
    in-out property <[RootRow]> roots: [];
    in-out property <[string]> naming: ["timestamp", "seq", "keep", "hash"];
    in-out property <int> naming-idx: 0;
    in-out property <string> seq-pad: "3";
    in-out property <bool> dedupe: true;
    in-out property <string> public-template: "";
    in-out property <[string]> obs: ["flat", "date", "vault", "note"];
    in-out property <int> obs-idx: 3;
    in-out property <string> trash-dir: "";
    in-out property <[TokenRow]> tokens: [];
    in-out property <[ImageRow]> images: [];
}

export global RemotesG {
    in-out property <[RemoteRow]> rows: [];
    in-out property <string> filter: "";
    in-out property <bool> loading: false;
    // 编辑器
    in-out property <bool> show-editor: false;
    in-out property <bool> edit-is-new: true;
    in-out property <string> edit-name: "";
    in-out property <[string]> types: ["local", "s3", "drive", "dropbox", "onedrive", "box", "gcs", "azureblob", "b2", "sftp", "webdav", "ftp", "smb", "alias", "crypt", "chunker", "union", "teldrive"];
    in-out property <int> type-idx: 0;
    in-out property <string> edit-params: "";
    // 模板驱动字段
    in-out property <[FieldRow]> edit-fields: [];
    in-out property <string> provider-desc: "";
    in-out property <bool> show-advanced: false;
    in-out property <bool> show-raw: false;  // 显示原始 key=value 编辑器
}

export global ServesG {
    in-out property <[ServeRow]> rows: [];
    in-out property <[string]> types: ["webdav", "sftp", "http", "ftp", "dlna", "nfs", "docker"];
    in-out property <int> type-idx: 0;
    in-out property <string> svc-name: "";
    in-out property <string> new-fs: "root://";
    // 远程路径历史记录（最多 10 条，最新在前）
    in-out property <[string]> history: [];
    in-out property <string> addr: "127.0.0.1:8080";
    in-out property <string> user: "";
    in-out property <string> pass: "";
    in-out property <bool> auto-run: true;
    in-out property <bool> busy: false;
    in-out property <string> search: "";
}

export global TransfersG {
    in-out property <[TaskRow]> tasks: [];
    in-out property <[string]> units: ["B", "KB", "MB", "GB"];
    // 全局限速草稿（空 = 不限；rclone 仅支持全局 tx:rx）
    in-out property <string> up-limit: "";
    in-out property <int> up-unit: 1;
    in-out property <string> down-limit: "";
    in-out property <int> down-unit: 1;
    // 全局实时网速（监控）
    in-out property <string> up-speed: "—";
    in-out property <string> down-speed: "—";
    in-out property <bool> hide-done: false;
    in-out property <string> task-search: "";
    in-out property <string> effective: "";  // 当前生效的全局限速（展示用）
}

export global SettingsG {
    in-out property <[string]> modes: ["托管模式（自动启动 rclone rcd）", "连接已有实例（attach）"];
    in-out property <int> mode-idx: 0;
    in-out property <string> exe: "";
    in-out property <string> rc-port: "5574";
    in-out property <string> rc-user: "gui";
    in-out property <string> rc-pass: "";
    in-out property <string> rc-url: "http://127.0.0.1:5572";
    in-out property <[string]> themes: ["跟随系统", "浅色", "深色"];
    in-out property <int> theme-idx: 0;
    in-out property <[string]> accents: ["蓝色", "绿色", "紫色", "橙色"];
    in-out property <int> accent-idx: 0;
    in-out property <bool> autostart: false;
    in-out property <bool> silent: false;
    in-out property <bool> http-enabled: true;
    in-out property <string> http-port: "5273";
    in-out property <string> cfg-path: "";
    in-out property <string> opt-transfers: "";
    in-out property <string> opt-checkers: "";
    in-out property <string> opt-tpslimit: "";
    in-out property <[string]> log-levels: ["DEBUG", "INFO", "NOTICE", "ERROR"];
    in-out property <int> log-level-idx: 1;
}

// ---------------- 通用组件 ----------------

// MDL2 图标字体（Windows 10+ 自带），避免 emoji 字形缺失
component MdlIcon inherits Text {
    in property <string> glyph;
    text: glyph;
    font-family: "Segoe MDL2 Assets";
    font-size: 16px;
    color: ThemeG.text-dim;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component IconBtn inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: ThemeG.radius-s;
    background: ta.pressed ? ThemeG.pressed : (ta.has-hover ? ThemeG.hover : transparent);
    HorizontalLayout {
        alignment: center;
        MdlIcon {
            glyph: root.label;
            font-size: 14px;
            color: root.danger ? ThemeG.err : ThemeG.text-dim;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PillBtn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> disabled: false;
    in property <bool> compact: false;
    callback clicked;
    height: root.compact ? 26px : 32px;
    min-width: root.compact ? 0px : 76px;
    border-radius: ThemeG.radius-s;
    background: root.disabled ? ThemeG.panel-2
        : root.primary ? (ta.pressed ? ThemeG.pressed : (ta.has-hover ? ThemeG.primary-hover : ThemeG.primary))
        : (ta.pressed ? ThemeG.pressed : (ta.has-hover ? ThemeG.hover : ThemeG.panel-2));
    border-width: root.primary ? 0px : 1px;
    border-color: ThemeG.border;
    opacity: root.disabled ? 0.55 : 1.0;
    HorizontalLayout {
        padding-left: root.compact ? 10px : 14px;
        padding-right: root.compact ? 10px : 14px;
        alignment: center;
        Text {
            text: root.label;
            font-size: root.compact ? 12px : 13px;
            font-weight: 500;
            color: root.primary ? white : (root.danger ? ThemeG.err : ThemeG.text);
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    in property <string> title: "";
    in property <length> pad: 16px;
    // fill=true 时子元素可拉伸占满卡片（用于列表类卡片）
    in property <bool> fill: false;
    background: ThemeG.panel;
    border-radius: ThemeG.radius;
    border-width: 1px;
    border-color: ThemeG.border;
    vertical-layout := VerticalLayout {
        padding: root.pad;
        alignment: root.fill ? LayoutAlignment.stretch : LayoutAlignment.start;
        if root.title != "": Rectangle {
            height: 36px;
            HorizontalLayout {
                padding-left: root.pad < 14px ? 14px : root.pad;
                padding-right: root.pad < 14px ? 14px : root.pad;
                Text {
                    text: root.title;
                    font-size: 14px;
                    font-weight: 700;
                    color: ThemeG.text;
                    vertical-alignment: center;
                }
            }
        }
        if root.title != "" && root.pad > 0px : Rectangle { height: 8px; }
        @children
    }
}

// 忙碌指示器：帧动画由 BusyG.frame 驱动（Rust 侧定时器推进）
component Spinner inherits Text {
    in property <bool> running: false;
    width: 18px;
    height: 20px;
    font-size: 15px;
    color: ThemeG.accent;
    vertical-alignment: center;
    text: ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"][Math.mod(BusyG.frame, 10)];
    visible: root.running;
}

component FieldLabel inherits Text {
    font-size: 12px;
    color: ThemeG.text-dim;
}

// 应用内确认弹窗：风格与整体 UI 一致、无系统提示音，锚定在触发元素（鼠标）附近
component ConfirmPop inherits PopupWindow {
    in property <string> title: "确认操作";
    in property <string> msg;
    in property <string> ok-label: "删除";
    callback confirmed;
    close-policy: PopupClosePolicy.close-on-click-outside;
    // 不设置 width/height：弹出时自动取内容首选尺寸
    card := Rectangle {
        width: 320px;
        background: ThemeG.panel;
        border-radius: ThemeG.radius;
        border-width: 1px;
        border-color: ThemeG.border;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 700;
                color: ThemeG.text;
            }
            Text {
                text: root.msg;
                font-size: 13px;
                color: ThemeG.text-dim;
                wrap: word-wrap;
            }
            Rectangle { height: 2px; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                PillBtn { label: "取消"; clicked => { root.close(); } }
                PillBtn { label: root.ok-label; danger: true; clicked => { root.close(); root.confirmed(); } }
            }
        }
    }
}

// 右键菜单项
component MenuItemBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked;
    height: 32px;
    border-radius: ThemeG.radius-s;
    background: mta.has-hover ? ThemeG.hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        MdlIcon {
            glyph: root.glyph;
            width: 16px;
            font-size: 12px;
            color: root.danger ? ThemeG.err : ThemeG.text-dim;
        }
        Text {
            text: root.label;
            font-size: 13px;
            color: root.danger ? ThemeG.err : ThemeG.text;
            vertical-alignment: center;
        }
    }
    mta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> sub: "";
    in property <color> tint: ThemeG.accent;
    background: ThemeG.panel;
    border-radius: ThemeG.radius;
    border-width: 1px;
    border-color: ThemeG.border;
    VerticalLayout {
        padding: 16px;
        alignment: start;
        Text { text: root.label; font-size: 12px; color: ThemeG.text-dim; }
        Rectangle { height: 6px; }
        HorizontalLayout {
            Rectangle { width: 4px; height: 22px; background: root.tint; border-radius: 2px; }
            Rectangle { width: 8px; }
            Text { text: root.value; font-size: 20px; font-weight: 700; color: ThemeG.text; vertical-alignment: center; }
        }
        if root.sub != "": Rectangle { height: 4px; }
        if root.sub != "": Text { text: root.sub; font-size: 11px; color: ThemeG.text-dim; }
    }
}

component SectionTitle inherits Text {
    font-size: 16px;
    font-weight: 600;
    color: ThemeG.text;
}

// 传输行（Dashboard / Transfers 复用）
component XferLine inherits Rectangle {
    in property <XferRow> xf;
    height: 40px;
    background: ThemeG.panel-2;
    border-radius: ThemeG.radius-s;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Rectangle {
            horizontal-stretch: 1;
            Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.xf.name;
                font-size: 12px;
                color: ThemeG.text;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        Text { text: root.xf.size; font-size: 12px; color: ThemeG.text-dim; width: 80px; vertical-alignment: center; }
        Text { text: root.xf.speed; font-size: 12px; color: ThemeG.accent; width: 90px; vertical-alignment: center; }
        Rectangle {
            width: 60px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 6px;
                    background: ThemeG.border;
                    border-radius: 3px;
                    Rectangle {
                        width: parent.width * root.xf.percent / 100;
                        height: 100%;
                        background: ThemeG.accent;
                        border-radius: 3px;
                    }
                }
            }
        }
    }
}

// ---------------- 视图 ----------------

component DashboardView inherits Rectangle {
    background: transparent;
    callback refresh;
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            // 统计行
            HorizontalLayout {
                spacing: 14px;
                height: 96px;
                StatTile {
                    label: "rclone 状态";
                    value: DashboardG.running ? "运行中" : "已停止";
                    sub: DashboardG.running ? (DashboardG.managed ? "托管 · " + DashboardG.url : "外部 · " + DashboardG.url) : "未连接";
                    tint: DashboardG.running ? ThemeG.ok : ThemeG.err;
                }
                StatTile {
                    label: "传输速度";
                    value: DashboardG.speed;
                    sub: "任务 " + DashboardG.transfers + " 个";
                }
                StatTile {
                    label: "累计流量";
                    value: DashboardG.total-bytes;
                    sub: "错误 " + DashboardG.errors + " 次";
                    tint: ThemeG.warn;
                }
                StatTile {
                    label: "资源总览";
                    value: DashboardG.remotes + " 远程";
                    sub: "挂载 " + DashboardG.mounts + " 个";
                    tint: ThemeG.ok;
                }
            }
            HorizontalLayout {
                spacing: 14px;
                Card {
                    title: "正在传输";
                    horizontal-stretch: 2;
                    VerticalLayout {
                        spacing: 2px;
                        if DashboardG.xfers.length == 0 : Text {
                            text: "当前没有进行中的传输";
                            font-size: 13px;
                            color: ThemeG.text-dim;
                        }
                        for xf in DashboardG.xfers : XferLine { xf: xf; }
                    }
                }
                Card {
                    title: "系统信息";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            height: 20px;
                            Text { text: "版本"; font-size: 12px; color: ThemeG.text-dim; width: 64px; vertical-alignment: center; }
                            Text { text: DashboardG.version; font-size: 13px; color: ThemeG.text; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            height: 20px;
                            Text { text: "平台"; font-size: 12px; color: ThemeG.text-dim; width: 64px; vertical-alignment: center; }
                            Text { text: DashboardG.os-info; font-size: 13px; color: ThemeG.text; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            height: 20px;
                            Text { text: "RC 地址"; font-size: 12px; color: ThemeG.text-dim; width: 64px; vertical-alignment: center; }
                            Text { text: DashboardG.url; font-size: 12px; color: ThemeG.text; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
        }
    }
}

component FilesView inherits Rectangle {
    background: transparent;
    callback refresh;
    callback open-row(int);
    callback go-up;
    callback mkdir;
    callback del-row(int);
    callback rename-row(int);
    callback copy-row(int);
    callback copy-link(int);
    // 右键菜单 / 弹窗所需的待操作状态
    property <int> op-idx: -1;
    property <string> op-name: "";
    property <bool> op-is-dir: false;
    property <length> menu-ax;
    property <length> menu-ay;
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 36px;
            ComboBox {
                width: 220px;
                model: FilesG.remotes;
                current-index <=> FilesG.remote-idx;
                changed current-index => {
                    FilesG.path = "";
                    root.refresh();
                }
            }
            Rectangle { width: 4px; }
            IconBtn { label: "\u{E74A}"; clicked => { root.go-up(); } }
            Rectangle {
                background: ThemeG.panel;
                border-radius: ThemeG.radius-s;
                border-width: 1px;
                border-color: ThemeG.border;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: FilesG.remote-idx >= 0 && FilesG.remotes.length > 0 ? FilesG.remotes[FilesG.remote-idx] + "/" + FilesG.path : "/";
                        font-size: 13px;
                        color: ThemeG.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Rectangle {}
            PillBtn { label: "新建文件夹"; clicked => { root.mkdir(); } }
            IconBtn { label: "\u{E72C}"; clicked => { root.refresh(); } }
        }
        Card {
            pad: 0px;
            fill: true;
            vertical-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 34px;
                    background: ThemeG.panel-2;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Rectangle {
                            horizontal-stretch: 1;
                            Text { text: "名称"; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        }
                        Text { text: "大小"; font-size: 12px; color: ThemeG.text-dim; width: 100px; vertical-alignment: center; }
                        Text { text: "修改时间"; font-size: 12px; color: ThemeG.text-dim; width: 170px; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for row[i] in FilesG.entries : Rectangle {
                            height: 38px;
                            background: FilesG.sel == i ? ThemeG.accent-soft : (ta.has-hover ? ThemeG.hover : transparent);
                            ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { FilesG.sel = i; FilesG.rename-name = row.name; }
                                double-clicked => { root.open-row(i); }
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                        FilesG.sel = i;
                                        FilesG.rename-name = row.name;
                                        root.op-idx = i;
                                        root.op-name = row.name;
                                        root.op-is-dir = row.is-dir;
                                        root.menu-ax = Math.max(0px, Math.min(self.absolute-position.x + self.mouse-x - root.absolute-position.x, root.width - 190px));
                                        root.menu-ay = Math.min(self.absolute-position.y + self.mouse-y - root.absolute-position.y, 120px);
                                        ctx.show();
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    MdlIcon {
                                        glyph: row.is-dir ? "\u{E8B7}" : "\u{E8A5}";
                                        x: 0;
                                        width: 20px;
                                        font-size: 14px;
                                        color: row.is-dir ? ThemeG.accent : ThemeG.text-dim;
                                    }
                                    Text {
                                        x: 26px;
                                        width: parent.width - 26px;
                                        height: parent.height;
                                        text: row.name;
                                        font-size: 13px;
                                        color: row.is-dir ? ThemeG.accent : ThemeG.text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: row.is-dir ? "—" : row.size; font-size: 12px; color: ThemeG.text-dim; width: 100px; vertical-alignment: center; }
                                Text { text: row.mtime; font-size: 12px; color: ThemeG.text-dim; width: 170px; vertical-alignment: center; }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: ThemeG.border;
                                opacity: 0.5;
                            }
                        }
                    }
                    // 加载遮罩：目录请求期间禁用文件点击 + spinner，防止拼出不存在的路径
                    if FilesG.loading : Rectangle {
                        background: #80808033;
                        block := TouchArea { }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Spinner { running: true; }
                            Text { text: "加载中…"; font-size: 12px; color: ThemeG.text; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
    // 右键菜单（原点击工具栏功能全部集成于此）
    ctx := PopupWindow {
        x: root.menu-ax;
        y: root.menu-ay;
        close-policy: PopupClosePolicy.close-on-click-outside;
        ctxcard := Rectangle {
            width: 170px;
            background: ThemeG.panel;
            border-radius: ThemeG.radius-s;
            border-width: 1px;
            border-color: ThemeG.border;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                MenuItemBtn {
                    glyph: "\u{E8AC}";
                    label: "重命名";
                    clicked => { ctx.close(); rnp.show(); }
                }
                MenuItemBtn {
                    glyph: "\u{E8C8}";
                    label: "复制一份";
                    clicked => { ctx.close(); root.copy-row(root.op-idx); }
                }
                if !root.op-is-dir : MenuItemBtn {
                    glyph: "\u{E71B}";
                    label: "复制直链";
                    clicked => { ctx.close(); root.copy-link(root.op-idx); }
                }
                MenuItemBtn {
                    glyph: "\u{E74D}";
                    label: "删除";
                    danger: true;
                    clicked => { ctx.close(); delp.show(); }
                }
            }
        }
    }
    // 重命名弹窗
    rnp := PopupWindow {
        x: root.menu-ax;
        y: root.menu-ay + 36px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        rnpcard := Rectangle {
            width: 400px;
            background: ThemeG.panel;
            border-radius: ThemeG.radius;
            border-width: 1px;
            border-color: ThemeG.border;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                FieldLabel { text: "重命名 " + root.op-name; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        width: 240px;
                        text <=> FilesG.rename-name;
                        accepted(t) => { rnp.close(); root.rename-row(root.op-idx); }
                    }
                    PillBtn { label: "确定"; primary: true; clicked => { rnp.close(); root.rename-row(root.op-idx); } }
                    PillBtn { label: "取消"; clicked => { rnp.close(); } }
                }
            }
        }
    }
    // 删除确认弹窗
    delp := ConfirmPop {
        title: "删除";
        msg: "确认删除 " + root.op-name + (root.op-is-dir ? "（文件夹将整体删除）？" : "？");
        x: root.menu-ax;
        y: root.menu-ay;
        confirmed => { root.del-row(root.op-idx); }
    }
}

component RemotesView inherits Rectangle {
    background: transparent;
    callback refresh;
    callback filter-changed(string);
    callback add;
    callback edit-row(int);
    callback del-row(int);
    callback editor-save;
    callback editor-cancel;
    callback type-changed;
    // 删除确认弹窗所需的待操作状态
    property <int> del-idx: -1;
    property <string> del-name: "";
    property <length> pop-ax;
    property <length> pop-ay;
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        // 工具条
        HorizontalLayout {
            spacing: 8px;
            height: 36px;
            LineEdit {
                width: 220px;
                text <=> RemotesG.filter;
                placeholder-text: "搜索远程名称";
                edited(t) => { root.filter-changed(t); }
            }
            PillBtn { label: "刷新"; clicked => { root.refresh(); } }
            Rectangle {}
            PillBtn { label: "＋ 新建远程"; primary: true; clicked => { root.add(); } }
        }
        // 编辑器
        if RemotesG.show-editor : Card {
            title: RemotesG.edit-is-new ? "新建远程存储" : "编辑远程存储：" + RemotesG.edit-name;
            VerticalLayout {
                spacing: 10px;
                // 名称 + 类型
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "名称（英文，不含空格或冒号）"; }
                        LineEdit { text <=> RemotesG.edit-name; enabled: RemotesG.edit-is-new; }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 180px;
                        FieldLabel { text: "类型"; }
                        ComboBox {
                            model: RemotesG.types;
                            current-index <=> RemotesG.type-idx;
                            enabled: RemotesG.edit-is-new;
                            selected(t) => { root.type-changed(); }
                        }
                    }
                }
                // 类型描述
                if RemotesG.provider-desc != "" : Text {
                    text: RemotesG.provider-desc;
                    font-size: 12px;
                    color: ThemeG.text-dim;
                    wrap: word-wrap;
                }
                // 参数字段（模板驱动）
                if RemotesG.edit-fields.length > 0 && !RemotesG.show-raw : Rectangle {
                    border-radius: ThemeG.radius-s;
                    border-width: 1px;
                    border-color: ThemeG.border;
                    background: ThemeG.panel-2;
                    height: 260px;
                    ScrollView {
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            for f[i] in RemotesG.edit-fields : VerticalLayout {
                                spacing: 2px;
                                if !f.is-advanced || RemotesG.show-advanced : VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 30px;
                                        // 标签
                                        Text {
                                            text: f.label + (f.required ? " *" : "");
                                            font-size: 12px;
                                            color: f.required ? ThemeG.text : ThemeG.text-dim;
                                            width: 180px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        // 输入控件
                                        if f.kind == "bool" : CheckBox {
                                            checked: f.value == "true";
                                            toggled => {
                                                RemotesG.edit-fields[i].value = self.checked ? "true" : "false";
                                            }
                                        }
                                        if f.kind != "bool" : LineEdit {
                                            horizontal-stretch: 1;
                                            text: f.value;
                                            input-type: f.kind == "password" ? InputType.password : InputType.text;
                                            edited(t) => {
                                                RemotesG.edit-fields[i].value = t;
                                            }
                                        }
                                    }
                                    // 帮助文本：置于输入框下方，超长自动换行
                                    if f.kind != "bool" && f.help != "" : HorizontalLayout {
                                        Rectangle { width: 188px; }
                                        Text {
                                            text: f.help;
                                            font-size: 11px;
                                            color: ThemeG.text-dim;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // 高级选项 + 原始编辑器切换
                HorizontalLayout {
                    spacing: 12px;
                    height: 28px;
                    if RemotesG.edit-fields.length > 0 : TouchArea {
                        mouse-cursor: pointer;
                        clicked => { RemotesG.show-advanced = !RemotesG.show-advanced; }
                        Text {
                            text: RemotesG.show-advanced ? "▾ 隐藏高级选项" : "▸ 显示高级选项";
                            font-size: 12px;
                            color: ThemeG.accent;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {}
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { RemotesG.show-raw = !RemotesG.show-raw; }
                        Text {
                            text: RemotesG.show-raw ? "切换到表单模式" : "切换到原始模式";
                            font-size: 12px;
                            color: ThemeG.accent;
                            vertical-alignment: center;
                        }
                    }
                }
                // 原始 key=value 编辑器（保留给高级用户）
                if RemotesG.show-raw || RemotesG.edit-fields.length == 0 : VerticalLayout {
                    spacing: 3px;
                    FieldLabel { text: "参数（每行一个 key=value，保存时将覆盖已有同名参数）"; }
                    Rectangle {
                        height: 140px;
                        background: ThemeG.panel-2;
                        border-radius: ThemeG.radius-s;
                        border-width: 1px;
                        border-color: ThemeG.border;
                        TextEdit { text <=> RemotesG.edit-params; font-size: 12px; }
                    }
                }
                // 按钮
                HorizontalLayout {
                    spacing: 8px;
                    PillBtn { label: "保存"; primary: true; clicked => { root.editor-save(); } }
                    PillBtn { label: "取消"; clicked => { root.editor-cancel(); } }
                    Rectangle {}
                }
            }
        }
        // 列表
        Card {
            title: "远程存储（" + RemotesG.rows.length + "）";
            pad: 0px;
            fill: true;
            vertical-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 36px;
                    background: ThemeG.panel-2;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Rectangle {
                            horizontal-stretch: 1;
                            Text { text: "名称"; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        }
                        Text { text: "类型"; font-size: 12px; color: ThemeG.text-dim; width: 120px; vertical-alignment: center; }
                        Text { text: "用量"; font-size: 12px; color: ThemeG.text-dim; width: 160px; vertical-alignment: center; }
                        Text { text: "操作"; font-size: 12px; color: ThemeG.text-dim; width: 150px; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for r[i] in RemotesG.rows : Rectangle {
                            height: 40px;
                            background: ta.has-hover ? ThemeG.hover : transparent;
                            ta := TouchArea { mouse-cursor: pointer; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Text { text: r.name; font-size: 13px; color: ThemeG.text; width: parent.width; overflow: elide; vertical-alignment: center; }
                                }
                                Text { text: r.rtype; font-size: 13px; color: ThemeG.text-dim; width: 120px; vertical-alignment: center; }
                                Text { text: r.usage; font-size: 12px; color: ThemeG.ok; width: 160px; vertical-alignment: center; }
                                HorizontalLayout {
                                    width: 150px;
                                    spacing: 6px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        PillBtn { label: "编辑"; compact: true; clicked => { root.edit-row(i); } }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        PillBtn {
                                            label: "删除";
                                            compact: true;
                                            danger: true;
                                            clicked => {
                                                root.del-idx = i;
                                                root.del-name = r.name;
                                                root.pop-ax = Math.max(0px, Math.min(self.absolute-position.x - root.absolute-position.x + self.width / 2 - 160px, root.width - 324px));
                                                root.pop-ay = self.absolute-position.y - root.absolute-position.y + self.height + 4px;
                                                delp.show();
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: ThemeG.border;
                                opacity: 0.5;
                            }
                        }
                    }
                }
            }
        }
    }
    // 删除确认弹窗（锚定在删除按钮附近）
    delp := ConfirmPop {
        title: "删除远程";
        msg: "确认删除远程存储 " + root.del-name + "？";
        x: root.pop-ax;
        y: root.pop-ay;
        confirmed => { root.del-row(root.del-idx); }
    }
}

component MountsView inherits Rectangle {
    background: transparent;
    callback refresh;
    callback add;
    callback remove(string);
    callback browse;
    callback path-nav(string);
    callback search-changed(string);
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            Text { text: "把远程仓库挂载为本地磁盘（需要 WinFsp）"; font-size: 13px; color: ThemeG.text-dim; vertical-alignment: center; }
            Rectangle {}
            LineEdit {
                width: 220px;
                text <=> MountsG.search;
                placeholder-text: "搜索本地/远程路径";
                edited(t) => { root.search-changed(t); }
            }
            IconBtn { label: "\u{E72C}"; clicked => { root.refresh(); } }
        }
        if !MountsG.winfsp-ok : Rectangle {
            height: 56px;
            background: ThemeG.panel;
            border-radius: ThemeG.radius;
            border-width: 1px;
            border-color: ThemeG.warn;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                Text { text: "⚠"; font-size: 16px; vertical-alignment: center; }
                Text { text: MountsG.winfsp-msg; font-size: 12px; color: ThemeG.warn; wrap: word-wrap; vertical-alignment: center; }
            }
        }
        Card {
            title: "新建挂载";
            VerticalLayout {
                spacing: 10px;
                // 第一行：远程 + 挂载点
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "远程路径（root://仓库/子目录）"; }
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit { text <=> MountsG.new-fs; placeholder-text: "root://"; horizontal-stretch: 1; }
                            dd-btn := IconBtn {
                                label: "\u{E70D}";
                                clicked => { hist-pop.show(); }
                            }
                            IconBtn {
                                label: "\u{E838}";
                                clicked => { root.browse(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 160px;
                        FieldLabel { text: "挂载点（盘符 / * 自动分配）"; }
                        LineEdit { text <=> MountsG.new-point; }
                    }
                }
                // 第二行：缓存模式 + 只读 + 自动挂载 + 挂载按钮
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        width: 160px;
                        FieldLabel { text: "缓存模式"; }
                        ComboBox {
                            model: MountsG.caches;
                            current-index <=> MountsG.cache-idx;
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 100px;
                        FieldLabel { text: "只读"; }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            CheckBox { checked <=> MountsG.ro; }
                            Rectangle {}
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 130px;
                        FieldLabel { text: "自动挂载"; }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            CheckBox { checked <=> MountsG.auto-mount; }
                            Rectangle {}
                        }
                    }
                    Rectangle {}
                    VerticalLayout {
                        spacing: 3px;
                        width: 96px;
                        FieldLabel { text: " "; }
                        PillBtn { label: "挂载"; primary: true; disabled: MountsG.busy; clicked => { root.add(); } }
                    }
                }
                FieldLabel { text: "勾选“自动挂载”并挂载成功后，下次启动软件将自动挂载；盘符挂载点如 T、T: 会自动规范为 T:\\"; }
            }
        }
        Card {
            title: "活动挂载（" + MountsG.mounts.length + "）";
            VerticalLayout {
                spacing: 2px;
                if MountsG.mounts.length == 0 : Text {
                    text: "暂无活动挂载";
                    font-size: 13px;
                    color: ThemeG.text-dim;
                }
                // 表头（与下方表单项使用相同宽度与对齐）
                if MountsG.mounts.length > 0 : Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { text: "本地路径"; width: 90px; font-size: 12px; color: ThemeG.text-dim; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "远程路径"; horizontal-stretch: 1; font-size: 12px; color: ThemeG.text-dim; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "操作"; width: 100px; font-size: 12px; color: ThemeG.text-dim; horizontal-alignment: left; vertical-alignment: center; }
                    }
                }
                for m[i] in MountsG.mounts : Rectangle {
                    height: 44px;
                    background: m.pending ? ThemeG.accent-soft : ThemeG.panel-2;
                    border-radius: ThemeG.radius-s;
                    border-width: m.pending ? 1px : 0px;
                    border-color: ThemeG.accent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { text: m.mount-point; font-size: 15px; font-weight: 700; color: ThemeG.accent; width: 90px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                        Text { text: m.fs; font-size: 13px; color: ThemeG.text; horizontal-stretch: 1; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                        HorizontalLayout {
                            width: 100px;
                            spacing: 6px;
                            alignment: start;
                            Spinner { running: m.pending; }
                            PillBtn { label: "卸载"; danger: true; disabled: m.pending; clicked => { root.remove(m.mount-point); } }
                        }
                    }
                }
            }
        }
    }
    // 远程路径历史记录下拉（锚定在"远程路径"输入框下方）
    hist-pop := PopupWindow {
        x: 40px;
        y: 118px;
        width: 320px;
        height: MountsG.history.length == 0 ? 60px : Math.min(MountsG.history.length * 30px + 12px, 260px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: ThemeG.panel;
            border-radius: ThemeG.radius;
            border-width: 1px;
            border-color: ThemeG.border;
            if MountsG.history.length == 0 : Text {
                text: "（暂无历史记录）";
                font-size: 12px;
                color: ThemeG.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if MountsG.history.length > 0 : ScrollView {
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    for h in MountsG.history : Rectangle {
                        height: 28px;
                        border-radius: ThemeG.radius-s;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text { text: "\u{E81C}"; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: ThemeG.accent; width: 16px; vertical-alignment: center; }
                            Text { text: h; font-size: 12px; color: ThemeG.text; overflow: elide; vertical-alignment: center; }
                        }
                        TouchArea {
                            clicked => {
                                hist-pop.close();
                                root.path-nav(h);
                            }
                        }
                    }
                }
            }
        }
    }
}

component ServesView inherits Rectangle {
    background: transparent;
    callback refresh;
    callback start;
    callback stop(string);
    callback browse;
    callback path-nav(string);
    callback search-changed(string);
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            Text { text: "网络服务（将远程以 WebDAV/SFTP 等方式共享到局域网）"; font-size: 13px; color: ThemeG.text-dim; vertical-alignment: center; }
            Rectangle {}
            LineEdit {
                width: 220px;
                text <=> ServesG.search;
                placeholder-text: "搜索 ID / 服务名称";
                edited(t) => { root.search-changed(t); }
            }
            IconBtn { label: "\u{E72C}"; clicked => { root.refresh(); } }
        }
        Card {
            title: "新建服务";
            VerticalLayout {
                spacing: 10px;
                // 第一行：服务名称 + 协议 + 远程 + 监听地址
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        width: 150px;
                        FieldLabel { text: "服务名称"; }
                        LineEdit { text <=> ServesG.svc-name; placeholder-text: "Serve_01"; }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 140px;
                        FieldLabel { text: "协议"; }
                        ComboBox {
                            model: ServesG.types;
                            current-index <=> ServesG.type-idx;
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "远程路径（root://仓库/子目录）"; }
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit { text <=> ServesG.new-fs; placeholder-text: "root://"; horizontal-stretch: 1; }
                            sdd-btn := IconBtn {
                                label: "\u{E70D}";
                                clicked => { sdd-pop.show(); }
                            }
                            IconBtn {
                                label: "\u{E838}";
                                clicked => { root.browse(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 200px;
                        FieldLabel { text: "监听地址"; }
                        LineEdit { text <=> ServesG.addr; }
                    }
                }
                // 第二行：用户 + 密码 + 启动按钮
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        width: 160px;
                        FieldLabel { text: "用户（可选）"; }
                        LineEdit { text <=> ServesG.user; }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 160px;
                        FieldLabel { text: "密码（可选）"; }
                        LineEdit { text <=> ServesG.pass; input-type: InputType.password; }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 120px;
                        FieldLabel { text: "自动启动"; }
                        HorizontalLayout {
                            spacing: 6px;
                            CheckBox { checked <=> ServesG.auto-run; }
                            Rectangle {}
                        }
                    }
                    Rectangle {}
                    Spinner { running: ServesG.busy; }
                    VerticalLayout {
                        spacing: 3px;
                        width: 96px;
                        FieldLabel { text: " "; }
                        PillBtn { label: "启动"; primary: true; disabled: ServesG.busy; clicked => { root.start(); } }
                    }
                }
            }
        }
        Card {
            title: "运行中服务（" + ServesG.rows.length + "）";
            pad: 0px;
            fill: true;
            vertical-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 36px;
                    background: ThemeG.panel-2;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Rectangle {
                            horizontal-stretch: 1;
                            Text { text: "服务名称"; font-size: 12px; color: ThemeG.text-dim; width: parent.width; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                        }
                        Text { text: "ID"; font-size: 12px; color: ThemeG.text-dim; width: 190px; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "协议"; font-size: 12px; color: ThemeG.text-dim; width: 90px; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "远程"; font-size: 12px; color: ThemeG.text-dim; width: 170px; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "地址"; font-size: 12px; color: ThemeG.text-dim; width: 150px; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "操作"; font-size: 12px; color: ThemeG.text-dim; width: 80px; horizontal-alignment: left; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for s[i] in ServesG.rows : Rectangle {
                            height: 40px;
                            background: ta.has-hover ? ThemeG.hover : transparent;
                            ta := TouchArea { mouse-cursor: pointer; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Text { text: s.name; font-size: 12px; color: ThemeG.text; width: parent.width; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                }
                                Text { text: s.id; font-size: 12px; color: ThemeG.text-dim; width: 190px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                Text { text: s.stype; font-size: 12px; color: ThemeG.text-dim; width: 90px; horizontal-alignment: left; vertical-alignment: center; }
                                Text { text: s.fs; font-size: 12px; color: ThemeG.text; width: 170px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                Text { text: s.addr; font-size: 12px; color: ThemeG.ok; width: 150px; horizontal-alignment: left; vertical-alignment: center; }
                                HorizontalLayout {
                                    width: 80px;
                                    VerticalLayout { alignment: center; PillBtn { label: "停止"; compact: true; danger: true; clicked => { root.stop(s.id); } } }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: ThemeG.border;
                                opacity: 0.5;
                            }
                        }
                    }
                }
            }
        }
    }
    // 远程路径历史记录下拉（锚定在"远程路径"输入框下方）
    sdd-pop := PopupWindow {
        x: 40px;
        y: 118px;
        width: 320px;
        height: ServesG.history.length == 0 ? 60px : Math.min(ServesG.history.length * 30px + 12px, 260px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: ThemeG.panel;
            border-radius: ThemeG.radius;
            border-width: 1px;
            border-color: ThemeG.border;
            if ServesG.history.length == 0 : Text {
                text: "（暂无历史记录）";
                font-size: 12px;
                color: ThemeG.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if ServesG.history.length > 0 : ScrollView {
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    for h in ServesG.history : Rectangle {
                        height: 28px;
                        border-radius: ThemeG.radius-s;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text { text: "\u{E81C}"; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: ThemeG.accent; width: 16px; vertical-alignment: center; }
                            Text { text: h; font-size: 12px; color: ThemeG.text; overflow: elide; vertical-alignment: center; }
                        }
                        TouchArea {
                            clicked => {
                                sdd-pop.close();
                                root.path-nav(h);
                            }
                        }
                    }
                }
            }
        }
    }
}

// 标签小胶囊（后台任务标签用）
component TagPill inherits Rectangle {
    in property <string> label;
    in property <color> tint: ThemeG.accent;
    height: 22px;
    border-radius: 4px;
    background: ThemeG.panel-2;
    border-width: 1px;
    border-color: root.tint;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-size: 11px;
            color: root.tint;
            vertical-alignment: center;
        }
    }
    @children
}

component TransfersView inherits Rectangle {
    background: transparent;
    callback refresh;
    callback hide-done-changed;
    callback task-search(string);
    callback limit-apply();                  // 应用全局限速（tx:rx）
    callback job-stop(int);

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 34px;
            Text { text: "传输"; font-size: 16px; font-weight: 700; color: ThemeG.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            LineEdit {
                width: 200px;
                text <=> TransfersG.task-search;
                placeholder-text: "搜索任务";
                edited(t) => { root.task-search(t); }
            }
            CheckBox {
                text: "隐藏已完成任务";
                checked <=> TransfersG.hide-done;
                toggled => { root.hide-done-changed(); }
            }
            IconBtn { label: "\u{E72C}"; clicked => { root.refresh(); } }
        }
        if TransfersG.effective != "" : Text {
            text: "当前生效的全局限速：" + TransfersG.effective;
            font-size: 12px;
            color: ThemeG.text-dim;
        }

        // ---------- 网速监控 + 全局限速（rclone 仅支持全局 tx:rx） ----------
        Card {
            title: "网速与限速";
            fill: false;
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 24px;
                    Text { text: "上传 ↑ " + TransfersG.up-speed; font-size: 13px; color: ThemeG.accent; vertical-alignment: center; }
                    Text { text: "下载 ↓ " + TransfersG.down-speed; font-size: 13px; color: ThemeG.ok; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "上传限速"; width: 64px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                    LineEdit {
                        width: 140px;
                        text <=> TransfersG.up-limit;
                        placeholder-text: "不限";
                    }
                    ComboBox {
                        width: 76px;
                        model: TransfersG.units;
                        current-index <=> TransfersG.up-unit;
                    }
                    Rectangle { width: 16px; }
                    Text { text: "下载限速"; width: 64px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                    LineEdit {
                        width: 140px;
                        text <=> TransfersG.down-limit;
                        placeholder-text: "不限";
                    }
                    ComboBox {
                        width: 76px;
                        model: TransfersG.units;
                        current-index <=> TransfersG.down-unit;
                    }
                    PillBtn { label: "应用限速"; primary: true; compact: true; clicked => { root.limit-apply(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // ---------- 后台任务 ----------
        Card {
            title: "后台任务（" + TransfersG.tasks.length + "）";
            pad: 0px;
            fill: true;
            vertical-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 36px;
                    background: ThemeG.panel-2;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        Text { text: "任务ID"; width: 90px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "标签"; horizontal-stretch: 1; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "状态"; width: 90px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "耗时"; width: 100px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "速度"; width: 100px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "操作"; width: 64px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for t[i] in TransfersG.tasks : Rectangle {
                            height: 42px;
                            background: hit2.has-hover ? ThemeG.hover : transparent;
                            hit2 := TouchArea { mouse-cursor: pointer; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                Text { text: "#" + t.id; width: 90px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text; vertical-alignment: center; }
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    if t.op != "" : TagPill { label: t.op; tint: t.op == "上传" ? ThemeG.ok : ThemeG.accent; }
                                    if t.remote != "" : TagPill {
                                        label: t.remote;
                                        tint: ThemeG.text-dim;
                                        Tooltip { text: @markdown("\{t.path}"); }
                                    }
                                    if t.svc != "" : TagPill { label: t.svc; tint: ThemeG.warn; }
                                }
                                Text { text: t.status; width: 90px; horizontal-alignment: left; font-size: 12px; color: t.status == "运行中" ? ThemeG.accent : (t.status == "失败" ? ThemeG.err : ThemeG.text-dim); vertical-alignment: center; }
                                Text { text: t.duration; width: 100px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                                Text { text: t.speed; width: 100px; horizontal-alignment: left; font-size: 12px; color: ThemeG.accent; vertical-alignment: center; }
                                HorizontalLayout {
                                    width: 64px;
                                    VerticalLayout { alignment: center; if !t.done : PillBtn { label: "停止"; compact: true; danger: true; clicked => { root.job-stop(t.id); } } }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ThemeG.border; opacity: 0.5; }
                        }
                    }
                }
            }
        }
    }
}

component PluginsView inherits Rectangle {
    background: transparent;
    callback rescan;
    callback save-config;
    callback add-root;
    callback del-root(int);
    callback root-default(int);
    callback add-token;
    callback revoke-token(int);
    callback copy-token(string);
    callback images-refresh;
    callback image-del(int);
    callback copy-url(int);
    callback plugin-toggle(int);
    // 确认弹窗所需的待操作状态
    property <int> tok-idx: -1;
    property <string> tok-name: "";
    property <int> img-idx: -1;
    property <string> img-path: "";
    property <length> pop-ax;
    property <length> pop-ay;
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            HorizontalLayout {
                height: 36px;
                Text { text: "插件（WASM，放入插件目录即自动加载；点击插件栏展开 / 收起）"; font-size: 13px; color: ThemeG.text-dim; vertical-alignment: center; }
                Rectangle {}
                IconBtn { label: "\u{E72C}"; clicked => { root.rescan(); } }
            }
            if PluginsG.rows.length == 0 : Card {
                Text { text: "未发现插件"; font-size: 13px; color: ThemeG.text-dim; }
            }
            for p[i] in PluginsG.rows : Rectangle {
                background: ThemeG.panel;
                border-radius: ThemeG.radius;
                border-width: 1px;
                border-color: PluginsG.expanded == i ? ThemeG.accent : ThemeG.border;
                clip: true;
                VerticalLayout {
                    alignment: start;
                    // ---- 卷帘头（始终显示；复选框固定于右侧中间） ----
                    Rectangle {
                        height: 56px;
                        background: PluginsG.expanded == i ? ThemeG.accent-soft : transparent;
                        hta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { PluginsG.expanded = PluginsG.expanded == i ? -1 : i; }
                        }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 12px;
                            MdlIcon {
                                glyph: "\u{EA86}";
                                width: 22px;
                                font-size: 17px;
                                color: p.enabled ? ThemeG.accent : ThemeG.text-dim;
                            }
                            Text { text: p.name; font-size: 14px; font-weight: 600; color: p.enabled ? ThemeG.text : ThemeG.text-dim; vertical-alignment: center; }
                            Text { text: "v" + p.version; font-size: 11px; color: ThemeG.text-dim; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                Text { text: p.desc; font-size: 12px; color: ThemeG.text-dim; width: parent.width; overflow: elide; vertical-alignment: center; }
                            }
                            Text { text: p.enabled ? "已启用" : "已停用"; font-size: 12px; color: p.enabled ? ThemeG.ok : ThemeG.text-dim; vertical-alignment: center; }
                            MdlIcon {
                                glyph: PluginsG.expanded == i ? "\u{E70E}" : "\u{E70D}";
                                width: 20px;
                                font-size: 13px;
                            }
                            CheckBox {
                                checked: p.enabled;
                                toggled => { root.plugin-toggle(i); }
                            }
                        }
                    }
                    // ---- 卷帘内容（仅展开时渲染） ----
                    if PluginsG.expanded == i : VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 16px;
                        spacing: 14px;
                        Rectangle { height: 1px; background: ThemeG.border; }
                        if p.id != "imagehost" : Text {
                            text: "该插件没有配置面板";
                            font-size: 12px;
                            color: ThemeG.text-dim;
                        }
                        if p.id == "imagehost" : VerticalLayout {
                            spacing: 14px;
                            // 存储根
                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "存储根（第一项为默认根）"; font-size: 12px; font-weight: 600; color: ThemeG.text-dim; }
                                for r[ri] in PluginsG.roots : Rectangle {
                                    height: 44px;
                                    background: ThemeG.panel-2;
                                    border-radius: ThemeG.radius-s;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text { text: r.id; font-size: 12px; color: ThemeG.text-dim; width: 70px; vertical-alignment: center; }
                                        Text { text: r.remote; font-size: 13px; color: ThemeG.text; vertical-alignment: center; overflow: elide; }
                                        if r.public-template != "" : Text { text: "→ " + r.public-template; font-size: 11px; color: ThemeG.ok; vertical-alignment: center; overflow: elide; }
                                        Rectangle {}
                                        PillBtn {
                                            label: r.is-default ? "默认" : "设为默认";
                                            compact: true;
                                            primary: r.is-default;
                                            clicked => { root.root-default(ri); }
                                        }
                                        IconBtn { label: "\u{E711}"; danger: true; clicked => { root.del-root(ri); } }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    PillBtn { label: "＋ 添加根（默认第一个远程）"; clicked => { root.add-root(); } }
                                    Rectangle {}
                                    PillBtn { label: "保存图床配置"; primary: true; clicked => { root.save-config(); } }
                                }
                            }
                            // 命名与去重
                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "命名与去重"; font-size: 12px; font-weight: 600; color: ThemeG.text-dim; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;
                                    FieldLabel { text: "命名模式"; width: 70px; vertical-alignment: center; }
                                    ComboBox {
                                        width: 160px;
                                        model: PluginsG.naming;
                                        current-index <=> PluginsG.naming-idx;
                                    }
                                    FieldLabel { text: "序号补零"; width: 60px; vertical-alignment: center; }
                                    LineEdit { width: 160px; text <=> PluginsG.seq-pad; }
                                    CheckBox { checked <=> PluginsG.dedupe; text: "SHA1 去重秒传"; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;
                                    FieldLabel { text: "Obsidian 布局"; width: 90px; vertical-alignment: center; }
                                    ComboBox {
                                        width: 160px;
                                        model: PluginsG.obs;
                                        current-index <=> PluginsG.obs-idx;
                                    }
                                    FieldLabel { text: "回收站目录"; width: 70px; vertical-alignment: center; }
                                    LineEdit { text <=> PluginsG.trash-dir; placeholder-text: "留空直接删除"; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;
                                    FieldLabel { text: "公网直链模板"; width: 90px; vertical-alignment: center; }
                                    LineEdit {
                                        text <=> PluginsG.public-template;
                                        placeholder-text: "如 https://cdn.example.com/d/{path}/{filename}（teldrive）";
                                    }
                                }
                            }
                            // 访问令牌
                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "访问令牌（Bearer）"; font-size: 12px; font-weight: 600; color: ThemeG.text-dim; }
                                if PluginsG.tokens.length == 0 : Text {
                                    text: "未创建令牌（未配置时不鉴权）";
                                    font-size: 12px;
                                    color: ThemeG.text-dim;
                                }
                                for t[ti] in PluginsG.tokens : Rectangle {
                                    height: 30px;
                                    background: ThemeG.panel-2;
                                    border-radius: ThemeG.radius-s;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Text { text: t.name; font-size: 12px; color: ThemeG.text; width: 90px; vertical-alignment: center; }
                                        Text { text: t.token; font-size: 11px; font-family: "Consolas"; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; }
                                        Rectangle {}
                                        IconBtn { label: "\u{E8C8}"; clicked => { root.copy-token(t.token); } }
                                        IconBtn {
                                            label: "\u{E711}";
                                            danger: true;
                                            clicked => {
                                                root.tok-idx = ti;
                                                root.tok-name = t.name;
                                                root.pop-ax = Math.max(0px, Math.min(self.absolute-position.x - root.absolute-position.x + self.width / 2 - 160px, root.width - 324px));
                                                root.pop-ay = self.absolute-position.y - root.absolute-position.y + self.height + 4px;
                                                tp.show();
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    Rectangle {}
                                    PillBtn { label: "＋ 新建令牌"; compact: true; clicked => { root.add-token(); } }
                                }
                            }
                            // 图床文件
                            VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    height: 28px;
                                    Text { text: "图床文件（" + PluginsG.images.length + "）"; font-size: 12px; font-weight: 600; color: ThemeG.text-dim; vertical-alignment: center; }
                                    Rectangle {}
                                    PillBtn { label: "刷新索引"; compact: true; clicked => { root.images-refresh(); } }
                                }
                                if PluginsG.images.length == 0 : Text {
                                    text: "索引为空";
                                    font-size: 12px;
                                    color: ThemeG.text-dim;
                                }
                                if PluginsG.images.length > 0 : Rectangle {
                                    height: 220px;
                                    ListView {
                                        for im[imi] in PluginsG.images : Rectangle {
                                            height: 34px;
                                            background: ta.has-hover ? ThemeG.hover : transparent;
                                            ta := TouchArea { mouse-cursor: pointer; }
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    Text { text: im.path; font-size: 12px; color: ThemeG.text; width: parent.width; overflow: elide; vertical-alignment: center; }
                                                }
                                                Text { text: im.size; font-size: 11px; color: ThemeG.text-dim; width: 70px; vertical-alignment: center; }
                                                Text { text: im.uploaded; font-size: 11px; color: ThemeG.text-dim; width: 150px; vertical-alignment: center; }
                                                IconBtn { label: "\u{E8C8}"; clicked => { root.copy-url(imi); } }
                                                IconBtn {
                                                    label: "\u{E74D}";
                                                    danger: true;
                                                    clicked => {
                                                        root.img-idx = imi;
                                                        root.img-path = im.path;
                                                        root.pop-ax = Math.max(0px, Math.min(self.absolute-position.x - root.absolute-position.x + self.width / 2 - 160px, root.width - 324px));
                                                        root.pop-ay = self.absolute-position.y - root.absolute-position.y + self.height + 4px;
                                                        ip.show();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // 撤销令牌确认弹窗
    tp := ConfirmPop {
        title: "撤销令牌";
        msg: "确认撤销令牌 " + root.tok-name + "？";
        ok-label: "撤销";
        x: root.pop-ax;
        y: root.pop-ay;
        confirmed => { root.revoke-token(root.tok-idx); }
    }
    // 删除图床文件确认弹窗
    ip := ConfirmPop {
        title: "删除文件";
        msg: "确认删除 " + root.img-path + "？";
        x: root.pop-ax;
        y: root.pop-ay;
        confirmed => { root.image-del(root.img-idx); }
    }
}

component SettingsView inherits Rectangle {
    background: transparent;
    callback save;
    callback test;
    callback pick-exe;
    callback options-save;
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Card {
                title: "rclone 连接";
                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        FieldLabel { text: "模式"; width: 46px; vertical-alignment: center; }
                        ComboBox {
                            width: 280px;
                            model: SettingsG.modes;
                            current-index <=> SettingsG.mode-idx;
                        }
                    }
                    if SettingsG.mode-idx == 0 : HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        FieldLabel { text: "rclone.exe"; width: 70px; vertical-alignment: center; }
                        LineEdit { text <=> SettingsG.exe; placeholder-text: "留空自动查找"; }
                        PillBtn { label: "浏览…"; compact: true; clicked => { root.pick-exe(); } }
                    }
                    if SettingsG.mode-idx == 0 : HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        FieldLabel { text: "RC 端口"; width: 56px; vertical-alignment: center; }
                        LineEdit { width: 160px; text <=> SettingsG.rc-port; }
                        FieldLabel { text: "RC 用户"; width: 56px; vertical-alignment: center; }
                        LineEdit { width: 160px; text <=> SettingsG.rc-user; }
                        FieldLabel { text: "RC 密码"; width: 56px; vertical-alignment: center; }
                        LineEdit { width: 160px; text <=> SettingsG.rc-pass; input-type: InputType.password; }
                    }
                    if SettingsG.mode-idx == 1 : HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        FieldLabel { text: "RC 地址"; width: 70px; vertical-alignment: center; }
                        LineEdit { width: 240px; text <=> SettingsG.rc-url; placeholder-text: "http://127.0.0.1:5572"; }
                        FieldLabel { text: "RC 用户"; width: 56px; vertical-alignment: center; }
                        LineEdit { width: 160px; text <=> SettingsG.rc-user; }
                        FieldLabel { text: "RC 密码"; width: 56px; vertical-alignment: center; }
                        LineEdit { width: 160px; text <=> SettingsG.rc-pass; input-type: InputType.password; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Card {
                    title: "外观与启动";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            FieldLabel { text: "主题"; width: 46px; vertical-alignment: center; }
                            ComboBox {
                                width: 160px;
                                model: SettingsG.themes;
                                current-index <=> SettingsG.theme-idx;
                                changed current-index => { root.save(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            height: 26px;
                            FieldLabel { text: "强调色"; width: 46px; vertical-alignment: center; }
                            for c[i] in [#1f6feb, #238636, #8957e5, #d4760a] : Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: c;
                                border-width: SettingsG.accent-idx == i ? 2px : 0px;
                                border-color: ThemeG.text;
                                ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { SettingsG.accent-idx = i; root.save(); }
                                }
                            }
                            Text { text: SettingsG.accents[SettingsG.accent-idx]; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 20px;
                            height: 28px;
                            CheckBox { checked <=> SettingsG.autostart; text: "开机自启"; toggled => { root.save(); } }
                            CheckBox { checked <=> SettingsG.silent; text: "静默启动（仅托盘）"; toggled => { root.save(); } }
                        }
                    }
                }
                Card {
                    title: "内嵌 HTTP 服务（图床 / 直链 / Obsidian）";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 12px;
                            height: 32px;
                            CheckBox { checked <=> SettingsG.http-enabled; text: "启用"; toggled => { root.save(); } }
                            FieldLabel { text: "端口"; width: 34px; vertical-alignment: center; }
                            LineEdit { width: 160px; text <=> SettingsG.http-port; }
                        }
                        FieldLabel { text: "上传 API：POST /api/plugin/imagehost/upload"; }
                        FieldLabel { text: "直链代理：GET /i/{rootId}/{path}"; }
                    }
                }
                Card {
                    title: "rclone 运行参数（立即生效）";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            FieldLabel { text: "Transfers"; width: 60px; vertical-alignment: center; }
                            LineEdit { width: 160px; text <=> SettingsG.opt-transfers; }
                            FieldLabel { text: "Checkers"; width: 60px; vertical-alignment: center; }
                            LineEdit { width: 160px; text <=> SettingsG.opt-checkers; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            FieldLabel { text: "TPSLimit"; width: 60px; vertical-alignment: center; }
                            LineEdit { width: 160px; text <=> SettingsG.opt-tpslimit; }
                            FieldLabel { text: "Log Level"; width: 60px; vertical-alignment: center; }
                            ComboBox { width: 160px; model: SettingsG.log-levels; current-index <=> SettingsG.log-level-idx; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            PillBtn { label: "保存运行参数"; primary: true; compact: true; clicked => { root.options-save(); } }
                            Rectangle {}
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                height: 36px;
                PillBtn { label: "保存设置"; primary: true; clicked => { root.save(); } }
                PillBtn { label: "测试连接"; clicked => { root.test(); } }
                Rectangle {}
                FieldLabel { text: "配置文件: " + SettingsG.cfg-path; vertical-alignment: center; }
            }
        }
    }
}

// ---------------- 主窗口 ----------------

export component MainWindow inherits Window {
    title: "Rclone GUI";
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 940px;
    min-height: 600px;
    background: ThemeG.bg;

    property <[string]> page-names: ["仪表盘", "文件", "远程", "挂载", "服务", "传输", "插件", "设置"];
    property <[string]> nav-icons: ["\u{E80F}", "\u{E8B7}", "\u{E753}", "\u{E8CE}", "\u{E909}", "\u{E895}", "\u{EA86}", "\u{E713}"];

    callback refresh-dashboard();
    callback nav-select(int);
    callback files-refresh();
    callback files-open(int);
    callback files-up();
    callback files-mkdir();
    callback files-del(int);
    callback files-rename(int);
    callback files-copy(int);
    callback files-copy-link(int);
    callback mounts-refresh();
    callback mount-add();
    callback mount-remove(string);
    callback mount-path-nav(string);
    callback mounts-search(string);
    callback serve-path-nav(string);
    callback serves-search(string);
    callback browse-open(int);
    callback browse-goto(string);
    callback browse-ok();
    callback remotes-refresh();
    callback remotes-filter(string);
    callback remote-add();
    callback remote-edit(int);
    callback remote-del(int);
    callback remote-editor-save();
    callback remote-editor-cancel();
    callback remote-type-changed();
    callback serves-refresh();
    callback serve-start();
    callback serve-stop(string);
    callback transfers-refresh();
    callback hide-done-changed();
    callback transfers-task-search(string);
    callback limit-apply();
    callback job-stop(int);
    callback plugins-rescan();
    callback ih-save-config();
    callback ih-add-root();
    callback ih-del-root(int);
    callback ih-root-default(int);
    callback ih-add-token();
    callback ih-revoke-token(int);
    callback ih-images-refresh();
    callback ih-image-del(int);
    callback ih-copy-url(int);
    callback copy-text(string);
    callback settings-save();
    callback settings-test();
    callback pick-exe();
    callback options-save();
    callback plugin-toggle(int);
    callback show-toast(int, string);

    init => {
        root.refresh-dashboard();
    }

    HorizontalLayout {
        // ---- 左侧栏 ----
        Rectangle {
            width: 64px;
            background: ThemeG.panel;
            VerticalLayout {
                padding-top: 12px;
                spacing: 2px;
                Rectangle {
                    height: 44px;
                    Rectangle {
                        width: 32px; height: 32px;
                        x: parent.width / 2 - 16px;
                        y: parent.height / 2 - 16px;
                        background: ThemeG.primary;
                        border-radius: 8px;
                        Text { text: "R"; color: white; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Rectangle { height: 8px; }
                for n[i] in root.page-names : Rectangle {
                    height: 52px;
                    background: NavG.idx == i ? ThemeG.accent-soft : (ta.has-hover ? ThemeG.hover : transparent);
                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { NavG.idx = i; root.nav-select(i); }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Rectangle {
                            height: 22px;
                            Text { text: root.nav-icons[i]; font-family: "Segoe MDL2 Assets"; font-size: 20px; color: NavG.idx == i ? ThemeG.accent : ThemeG.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                            // 启动预热中：远程图标右上角迷你 spinner（纯文本，不遮挡输入）
                            if i == 2 && NavG.starting : Text {
                                x: parent.width - 11px;
                                y: 0;
                                width: 11px;
                                height: 11px;
                                text: ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"][Math.mod(BusyG.frame, 10)];
                                font-size: 10px;
                                color: ThemeG.accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { text: n; font-size: 9px; color: NavG.idx == i ? ThemeG.accent : ThemeG.text-dim; horizontal-alignment: center; }
                    }
                    Rectangle {
                        x: 0; width: 3px; height: 24px;
                        y: parent.height / 2 - 12px;
                        background: NavG.idx == i ? ThemeG.accent : transparent;
                        border-radius: 2px;
                    }
                }
                Rectangle {}
                Rectangle {
                    height: 56px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px; height: 10px;
                                border-radius: 5px;
                                background: DashboardG.running ? ThemeG.ok : ThemeG.err;
                            }
                        }
                        Text { text: DashboardG.running ? "在线" : "离线"; font-size: 9px; color: ThemeG.text-dim; horizontal-alignment: center; }
                    }
                }
            }
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: 100%;
                background: ThemeG.border;
            }
        }

        // ---- 主区域 ----
        VerticalLayout {
            // 顶栏
            Rectangle {
                height: 48px;
                background: ThemeG.panel;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 20px;
                    spacing: 12px;
                    SectionTitle {
                        text: root.page-names[NavG.idx];
                        vertical-alignment: center;
                    }
                    Rectangle {}
                    Rectangle {
                    width: 140px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            background: ThemeG.panel-2;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: ThemeG.border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                Text { text: "\u{E895}"; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: ThemeG.accent; vertical-alignment: center; }
                                Text { text: DashboardG.speed; font-size: 12px; font-weight: 600; color: ThemeG.accent; vertical-alignment: center; }
                            }
                        }
                    }
                }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: ThemeG.border;
                }
            }

            // 内容
            Rectangle {
                background: ThemeG.bg;
                if NavG.idx == 0 : DashboardView {
                    refresh => { root.refresh-dashboard(); }
                }
                if NavG.idx == 1 : FilesView {
                    refresh => { root.files-refresh(); }
                    open-row(i) => { root.files-open(i); }
                    go-up => { root.files-up(); }
                    mkdir => { root.files-mkdir(); }
                    del-row(i) => { root.files-del(i); }
                    rename-row(i) => { root.files-rename(i); }
                    copy-row(i) => { root.files-copy(i); }
                    copy-link(i) => { root.files-copy-link(i); }
                }
                if NavG.idx == 2 : RemotesView {
                    refresh => { root.remotes-refresh(); }
                    filter-changed(t) => { root.remotes-filter(t); }
                    add => { root.remote-add(); }
                    edit-row(i) => { root.remote-edit(i); }
                    del-row(i) => { root.remote-del(i); }
                    editor-save => { root.remote-editor-save(); }
                    editor-cancel => { root.remote-editor-cancel(); }
                    type-changed => { root.remote-type-changed(); }
                }
                if NavG.idx == 3 : MountsView {
                    refresh => { root.mounts-refresh(); }
                    add => { root.mount-add(); }
                    remove(mp) => { root.mount-remove(mp); }
                    browse => { root.browse-open(0); }
                    path-nav(n) => { root.mount-path-nav(n); }
                    search-changed(t) => { root.mounts-search(t); }
                }
                if NavG.idx == 4 : ServesView {
                    refresh => { root.serves-refresh(); }
                    start => { root.serve-start(); }
                    stop(id) => { root.serve-stop(id); }
                    browse => { root.browse-open(1); }
                    path-nav(n) => { root.serve-path-nav(n); }
                    search-changed(t) => { root.serves-search(t); }
                }
                if NavG.idx == 5 : TransfersView {
                    refresh => { root.transfers-refresh(); }
                    hide-done-changed => { root.hide-done-changed(); }
                    task-search(t) => { root.transfers-task-search(t); }
                    limit-apply() => { root.limit-apply(); }
                    job-stop(id) => { root.job-stop(id); }
                }
                if NavG.idx == 6 : PluginsView {
                    rescan => { root.plugins-rescan(); }
                    save-config => { root.ih-save-config(); }
                    add-root => { root.ih-add-root(); }
                    del-root(i) => { root.ih-del-root(i); }
                    root-default(i) => { root.ih-root-default(i); }
                    add-token => { root.ih-add-token(); }
                    revoke-token(i) => { root.ih-revoke-token(i); }
                    copy-token(t) => { root.copy-text(t); }
                    images-refresh => { root.ih-images-refresh(); }
                    image-del(i) => { root.ih-image-del(i); }
                    copy-url(i) => { root.ih-copy-url(i); }
                    plugin-toggle(i) => { root.plugin-toggle(i); }
                }
                if NavG.idx == 7 : SettingsView {
                    save => { root.settings-save(); }
                    test => { root.settings-test(); }
                    pick-exe => { root.pick-exe(); }
                    options-save => { root.options-save(); }
                }
            }

            // 状态栏
            Rectangle {
                height: 26px;
                background: ThemeG.panel;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 16px;
                    Text { text: DashboardG.url; font-size: 11px; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; }
                    Rectangle {}
                    Text { text: "传输 " + DashboardG.transfers; font-size: 11px; color: ThemeG.text-dim; vertical-alignment: center; }
                    Text { text: "挂载 " + DashboardG.mounts; font-size: 11px; color: ThemeG.text-dim; vertical-alignment: center; }
                    Text { text: "错误 " + DashboardG.errors; font-size: 11px; color: DashboardG.errors > 0 ? ThemeG.err : ThemeG.text-dim; vertical-alignment: center; }
                }
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: ThemeG.border;
                }
            }
        }
    }

    // Toast
    if ToastG.show : Rectangle {
        x: parent.width / 2 - self.width / 2;
        y: parent.height - 64px;
        width: tmsg.preferred-width + 36px;
        height: 38px;
        border-radius: 19px;
        background: ThemeG.dark ? #21262df2 : #24292ff0;
        border-width: 1px;
        border-color: ThemeG.border;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            tmsg := Text {
                text: ToastG.msg;
                font-size: 13px;
                color: ToastG.kind == 2 ? ThemeG.err : (ToastG.kind == 1 ? ThemeG.ok : white);
                vertical-alignment: center;
            }
        }
    }

    // 远程路径浏览弹窗
    if BrowseG.show : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000066;
        TouchArea {}  // 拦截底层点击
        Rectangle {
            x: parent.width / 2 - self.width / 2;
            y: parent.height / 2 - self.height / 2;
            width: 520px;
            height: 480px;
            background: ThemeG.bg;
            border-radius: ThemeG.radius;
            border-width: 1px;
            border-color: ThemeG.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;
                    Text { text: "浏览远程路径"; font-size: 14px; font-weight: 700; color: ThemeG.text; vertical-alignment: center; }
                    Rectangle {}
                    IconBtn {
                        label: "\u{E72B}";  // 上级
                        clicked => { root.browse-goto(".."); }
                    }
                }
                Rectangle {
                    height: 30px;
                    background: ThemeG.panel-2;
                    border-radius: ThemeG.radius-s;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text { text: BrowseG.path; font-size: 12px; color: ThemeG.text-dim; overflow: elide; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: ThemeG.radius;
                    border-width: 1px;
                    border-color: ThemeG.border;
                    clip: true;
                    if BrowseG.entries.length == 0 : Text {
                        text: "（空）";
                        font-size: 13px;
                        color: ThemeG.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if BrowseG.entries.length > 0 : ListView {
                        for e[i] in BrowseG.entries : Rectangle {
                            height: 32px;
                            background: BrowseG.sel == i ? ThemeG.accent.with-alpha(0.25) : (rta.has-hover ? ThemeG.hover : transparent);
                            rta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { BrowseG.sel = i; }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text { text: e.is-dir ? "\u{E8B7}" : "\u{E8A5}"; font-size: 13px; color: e.is-dir ? ThemeG.accent : ThemeG.text-dim; width: 18px; vertical-alignment: center; }
                                Text { text: e.name; font-size: 13px; color: ThemeG.text; overflow: elide; vertical-alignment: center; }
                                Rectangle {}
                                if e.is-dir : IconBtn {
                                    label: "\u{E838}";
                                    clicked => { root.browse-goto(e.name); }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: ThemeG.border;
                                opacity: 0.4;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    alignment: end;
                    PillBtn { label: "取消"; clicked => { BrowseG.show = false; } }
                    PillBtn { label: "确定"; primary: true; clicked => { root.browse-ok(); } }
                }
            }
        }
    }
}
