import { ThemeG } from "theme.slint";
export { ThemeG }
import { LineEdit, ComboBox, ListView, ScrollView, CheckBox, TextEdit, Palette } from "std-widgets.slint";

// ---------------- 数据结构 ----------------

export struct XferRow {
    name: string,
    size: string,
    speed: string,
    percent: int,
}
export struct FileRow {
    name: string,
    is-dir: bool,
    size: string,
    mtime: string,
}
export struct MountRow {
    fs: string,
    mount-point: string,
    pending: bool,
}
export struct PluginRow {
    id: string,
    name: string,
    version: string,
    desc: string,
    loaded: bool,
    enabled: bool,
    // ---- 插件包（plugin package）扩展字段 ----
    // 类型： "wasm"（本进程内 WASM 插件）| "package"（外部程序插件包）
    kind: string,
    author: string,
    entry: string,
    // 完整性校验是否通过
    verified: bool,
    // 是否有专属配置界面（目前仅 imagehost 为 true）
    has-config: bool,
    // 状态提示（校验失败原因等）
    status: string,
    // 目录路径，便于用户定位
    path: string,
}
export struct RootRow {
    id: string,
    remote: string,
    is-default: bool,
    public-template: string,
}
export struct TokenRow {
    id: string,
    name: string,
    token: string,
    created: string,
}
export struct ImageRow {
    name: string,
    path: string,
    url: string,
    size: string,
    sha1: string,
    uploaded: string,
}
export struct RemoteRow {
    /// 该远程的凭据未随包导出（来自档案 needs_auth；无档案记录时恒为 false）
    needs-auth: bool,
    name: string,
    rtype: string,
    usage: string,
    /// 「代理」列显示的文本：「不代理」或代理目标（不含凭据）；悬空引用显示「配置已删除」
    proxy-label: string,
    /// 已保存绑定但尚未下发到 rclone（未连接 / 下发失败）
    proxy-pending: bool,
    /// 引用的代理配置已被删除，需要用户重新选择
    proxy-conflict: bool,
    /// 当前绑定的下拉框索引：0 = 不代理，n = proxy-options 的第 n 项
    proxy-index: int,
}
/// 代理配置卡片里的一行（**不含密码**）
export struct ProxyRow {
    id: string,
    name: string,
    protocol: string,
    /// 形如 http://host:port，永远不含账号密码
    target: string,
    /// 「有凭据」/「无」
    auth: string,
    /// 正在使用它的远程名，逗号分隔；无则为「—」
    used-by: string,
}
export struct FieldRow {
    name: string,
    label: string,
    kind: string,       // "text" | "password" | "bool" | "number" | "select"
    value: string,      // bool 为 "true"/"false"，select 为当前选中值
    required: bool,
    help: string,
    is-advanced: bool,
    options: string,    // select 类型的选项，逗号分隔
}
export struct ServeRow {
    id: string,
    name: string,
    stype: string,
    fs: string,
    addr: string,
}
export struct PathItem {
    name: string,
    is-dir: bool,
}
export struct TaskRow {
    id: int,
    op: string,
    remote: string,
    path: string,
    svc: string,
    status: string,
    duration: string,
    speed: string,
    done: bool,
}
/// 一条历史消息（toast 的留档）。
export struct LogRow {
    /// "0" 信息 / "1" 成功 / "2" 错误（用来选颜色）
    kind: string,
    /// HH:MM:SS
    time: string,
    msg: string,
}

// ---------------- 全局状态 ----------------

export global NavG {
    in-out property <int> idx: 0;
    // 启动预热进行中（连接握手 + 首次拉取远程/挂载/服务）
    in-out property <bool> starting: false;
    // 侧边栏「远程」图标是否显示 spinner：
    // 启动预热或远程页正在做任何异步操作（刷新、应用导入、下发代理）时为 true。
    // 这样用户在任何耗时操作时都能看到反馈，而不是只在程序启动时。
    out property <bool> remotes-busy: starting || RemotesG.loading;
}

export global ToastG {
    in-out property <bool> show: false;
    in-out property <string> msg: "";
    in-out property <int> kind: 0; // 0 info 1 ok 2 err
    /// 历史消息（最新在前）。所有 toast 都会追加到这里，
    /// 让用户能在「仪表盘 → 历史记录」里回看刚刚发生过什么
    /// （toast 只显示 2.6 秒，很容易错过）。
    in-out property <[LogRow]> history: [];
    /// 历史里是否包含错误（用于把标题染红，提醒有失败项）。
    /// 用 in-out 而不是 out：out 属性没有 setter，Rust 侧改不了。
    in-out property <bool> has-errors: false;
    /// 底部「错误」按钮弹出的错误面板是否可见。
    in-out property <bool> error-panel: false;
}

// 远程路径浏览弹窗
export global BrowseG {
    in-out property <bool> show: false;
    in-out property <int> scope: 0;      // 0 挂载 / 1 服务
    in-out property <string> path: "root://";
    in-out property <[PathItem]> entries: [];
    in-out property <int> sel: -1;       // 当前高亮选中行
}

export global DashboardG {
    in-out property <string> version: "—";
    in-out property <string> os-info: "—";
    in-out property <bool> running: false;
    in-out property <bool> managed: true;
    // 曾经连上、现在已断开：界面上显示的是上次快照（指南 §3 要求区分「运行中」与「陈旧」）
    in-out property <bool> stale: false;
    in-out property <string> url: "";
    in-out property <int> remotes: 0;
    in-out property <string> speed: "0 B/s";
    in-out property <string> total-bytes: "0 B";
    in-out property <int> transfers: 0;
    in-out property <[XferRow]> xfers: [];
    in-out property <int> mounts: 0;
    in-out property <int> errors: 0;
}

export global FilesG {
    in-out property <[string]> remotes: [];
    in-out property <int> remote-idx: 0;
    in-out property <string> path: "";
    in-out property <[FileRow]> entries: [];
    // 目录请求进行中：禁点文件 + spinner，成功后才更新路径
    in-out property <bool> loading: false;
    // 请求序号：新请求递增，旧请求的迟到结果按序号丢弃
    in-out property <int> seq: 0;
    in-out property <int> sel: -1;
    in-out property <string> rename-name: "";
}

export global MountsG {
    in-out property <[MountRow]> mounts: [];
    // 仓库（远程）列表 + 选中项；子路径相对仓库根
    in-out property <[string]> remotes: [];
    in-out property <int> remote-idx: 0;
    in-out property <string> sub-path: "";
    // 远程路径历史记录（最多 10 条，最新在前）
    in-out property <[string]> history: [];
    in-out property <string> new-point: "*";
    in-out property <bool> ro: false;
    in-out property <[string]> caches: ["off", "minimal", "writes", "full"];
    in-out property <int> cache-idx: 2;
    in-out property <bool> winfsp-ok: false;
    in-out property <string> winfsp-msg: "";
    in-out property <bool> busy: false;
    in-out property <string> search: "";
}

export global PluginsG {
    in-out property <[PluginRow]> rows: [];
    in-out property <bool> loaded: false;
    // 插件目录（显示给用户，便于手动放置）
    in-out property <string> dir: "";
    // 当前展开的插件索引（-1 全部收起）
    in-out property <int> expanded: -1;
    in-out property <[RootRow]> roots: [];
    in-out property <[string]> naming: ["timestamp", "seq", "keep", "hash"];
    in-out property <int> naming-idx: 0;
    in-out property <string> seq-pad: "3";
    in-out property <bool> dedupe: true;
    in-out property <string> public-template: "";
    in-out property <[string]> obs: ["flat", "date", "vault", "note"];
    in-out property <int> obs-idx: 3;
    in-out property <string> trash-dir: "";
    in-out property <[TokenRow]> tokens: [];
    in-out property <[ImageRow]> images: [];
}

export global RemotesG {
    in-out property <[RemoteRow]> rows: [];
    in-out property <string> filter: "";
    /// 远程列表正在执行异步操作（刷新 / 应用导入 / 下发代理）。
    /// 驱动远程页与侧边栏「远程」图标的 spinner。
    in-out property <bool> loading: false;
    // 编辑器
    in-out property <bool> show-editor: false;
    in-out property <bool> edit-is-new: true;
    in-out property <string> edit-name: "";
    in-out property <[string]> types: ["local", "s3", "drive", "dropbox", "onedrive", "box", "gcs", "azureblob", "b2", "sftp", "webdav", "ftp", "smb", "alias", "crypt", "chunker", "union", "teldrive"];
    in-out property <int> type-idx: 0;
    in-out property <string> edit-params: "";
    // 模板驱动字段
    in-out property <[FieldRow]> edit-fields: [];
    in-out property <string> provider-desc: "";
    in-out property <bool> show-advanced: false;
    in-out property <bool> show-raw: false;  // 显示原始 key=value 编辑器
    // ---------------- 代理配置 ----------------
    /// 第 0 项固定是「不代理」，之后是已保存的配置
    in-out property <[string]> proxy-options: ["不代理"];
    /// 与 proxy-options 一一对应的说明（悬停提示）
    in-out property <[string]> proxy-option-hints: [];
    in-out property <[ProxyRow]> proxy-rows: [];
    in-out property <bool> proxy-show-editor: false;
    in-out property <bool> proxy-edit-is-new: true;
    in-out property <string> proxy-edit-id: "";
    in-out property <string> proxy-edit-name: "";
    in-out property <[string]> proxy-protocols: ["HTTP", "HTTPS", "SOCKS5", "SOCKS5H"];
    in-out property <int> proxy-edit-proto: 0;
    in-out property <string> proxy-edit-host: "";
    in-out property <string> proxy-edit-port: "8080";
    in-out property <string> proxy-edit-user: "";
    in-out property <string> proxy-edit-pass: "";
    /// 删除确认：会影响哪些远程
    in-out property <string> proxy-del-id: "";
    in-out property <string> proxy-del-name: "";
    in-out property <string> proxy-del-affected: "";
    in-out property <bool> proxy-del-show: false;
}

export global ServesG {
    in-out property <[ServeRow]> rows: [];
    in-out property <[string]> types: ["webdav", "sftp", "http", "ftp", "dlna", "nfs", "docker"];
    in-out property <int> type-idx: 0;
    in-out property <string> svc-name: "";
    // 仓库（远程）列表 + 选中项；子路径相对仓库根
    in-out property <[string]> remotes: [];
    in-out property <int> remote-idx: 0;
    in-out property <string> sub-path: "";
    // 远程路径历史记录（最多 10 条，最新在前）
    in-out property <[string]> history: [];
    in-out property <string> addr: "127.0.0.1:8080";
    in-out property <string> user: "";
    in-out property <string> pass: "";
    in-out property <bool> busy: false;
    in-out property <string> search: "";
}

export global TransfersG {
    in-out property <[TaskRow]> tasks: [];
    in-out property <[string]> units: ["B", "KB", "MB", "GB"];
    // 全局限速草稿（空 = 不限；rclone 仅支持全局 tx:rx）
    in-out property <string> up-limit: "";
    in-out property <int> up-unit: 1;
    in-out property <string> down-limit: "";
    in-out property <int> down-unit: 1;
    // 全局实时网速（监控）
    in-out property <string> up-speed: "—";
    in-out property <string> down-speed: "—";
    in-out property <bool> hide-done: false;
    in-out property <string> task-search: "";
    in-out property <string> effective: "";  // 当前生效的全局限速（展示用）
}

export global SettingsG {
    in-out property <string> rc-user: "gui";
    /// 启动时自动连接该 endpoint（只连 API，不启动 rclone 进程）
    in-out property <bool> connect-on-start: true;
    in-out property <string> rc-pass: "";
    in-out property <string> rc-url: "http://127.0.0.1:5572";
    in-out property <[string]> themes: ["跟随系统", "浅色", "深色"];
    in-out property <int> theme-idx: 0;
    in-out property <[string]> accents: ["蓝色", "绿色", "紫色", "橙色"];
    in-out property <int> accent-idx: 0;
    in-out property <bool> autostart: false;
    in-out property <bool> silent: false;
    /// 「以管理员身份运行」：反映当前进程真实权限（由 Rust 在启动时读取令牌）
    in-out property <bool> run-as-admin: false;
    /// 切换权限前确认弹窗的正文（“软件将重启”）
    in-out property <string> admin-confirm-msg: "";
    /// 页面内确认弹层是否显示
    in-out property <bool> admin-confirm-show: false;
    in-out property <bool> http-enabled: true;
    in-out property <string> http-port: "5273";
    in-out property <string> cfg-path: "";
    in-out property <string> opt-transfers: "";
    in-out property <string> opt-checkers: "";
    in-out property <string> opt-tpslimit: "";
    in-out property <[string]> log-levels: ["DEBUG", "INFO", "NOTICE", "ERROR"];
    in-out property <int> log-level-idx: 1;

    // ---------- 连接状态区（阶段 3） ----------
    // status 文案由 Rust 侧按 ConnStatus 给出：未连接 / 已连接 / 已断开（显示的是上次快照）
    in-out property <string> conn-status: "未连接";
    in-out property <bool> conn-live: false;
    in-out property <bool> conn-stale: false;
    in-out property <bool> conn-busy: false;
    in-out property <string> conn-endpoint: "";
    in-out property <string> conn-version: "—";
    in-out property <string> conn-config-path: "—";
    in-out property <string> conn-last-refresh: "—";
    in-out property <string> conn-error: "";

    // ---------- 档案导入 / 导出（阶段 5A） ----------
    /// 已有「导入预览」结果、可以点「应用导入」时置 true（两步流程 = 一次确认）
    in-out property <bool> conf-pending: false;
    /// 导出时是否携带凭据：默认 false（默认排除所有可识别凭据）
    in-out property <bool> conf-include-secrets: false;
    /// 导出含凭据时的确认弹窗开关（仅影响本次导出，不保存任何授权状态）
    in-out property <bool> conf-confirm-show: false;
    in-out property <string> conf-confirm-msg: "";
    /// 恢复脚本预览（完整正文）与保存位置
    in-out property <string> script-preview: "";
    in-out property <string> script-path: "";
    /// 最近一次预览/应用的摘要文本（不含任何凭据内容）
    in-out property <string> conf-info: "默认不含凭据（勾选后才写入）；导入需先预览，应用前自动备份当前档案。";
}

// ---------------- 通用组件 ----------------

// MDL2 图标字体（Windows 10+ 自带），避免 emoji 字形缺失
component MdlIcon inherits Text {
    in property <string> glyph;
    text: glyph;
    font-family: "Segoe MDL2 Assets";
    font-size: 16px;
    color: ThemeG.text-dim;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component IconBtn inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: ThemeG.radius-s;
    background: ta.pressed ? ThemeG.pressed : (ta.has-hover ? ThemeG.hover : transparent);
    HorizontalLayout {
        alignment: center;
        MdlIcon {
            glyph: root.label;
            font-size: 14px;
            color: root.danger ? ThemeG.err : ThemeG.text-dim;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PillBtn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> disabled: false;
    in property <bool> compact: false;
    callback clicked;
    height: root.compact ? 26px : 32px;
    min-width: root.compact ? 0px : 76px;
    border-radius: ThemeG.radius-s;
    background: root.disabled ? ThemeG.panel-2
        : root.primary ? (ta.pressed ? ThemeG.pressed : (ta.has-hover ? ThemeG.primary-hover : ThemeG.primary))
        : (ta.pressed ? ThemeG.pressed : (ta.has-hover ? ThemeG.hover : ThemeG.panel-2));
    border-width: root.primary ? 0px : 1px;
    border-color: ThemeG.border;
    opacity: root.disabled ? 0.55 : 1.0;
    HorizontalLayout {
        padding-left: root.compact ? 10px : 14px;
        padding-right: root.compact ? 10px : 14px;
        alignment: center;
        Text {
            text: root.label;
            font-size: root.compact ? 12px : 13px;
            font-weight: 500;
            color: root.primary ? white : (root.danger ? ThemeG.err : ThemeG.text);
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    in property <string> title: "";
    in property <length> pad: 16px;
    // fill=true 时子元素可拉伸占满卡片（用于列表类卡片）
    in property <bool> fill: false;
    background: ThemeG.panel;
    border-radius: ThemeG.radius;
    border-width: 1px;
    border-color: ThemeG.border;
    vertical-layout := VerticalLayout {
        padding: root.pad;
        alignment: root.fill ? LayoutAlignment.stretch : LayoutAlignment.start;
        if root.title != "": Rectangle {
            height: 36px;
            HorizontalLayout {
                padding-left: root.pad < 14px ? 14px : root.pad;
                padding-right: root.pad < 14px ? 14px : root.pad;
                Text {
                    text: root.title;
                    font-size: 14px;
                    font-weight: 700;
                    color: ThemeG.text;
                    vertical-alignment: center;
                }
            }
        }
        if root.title != "" && root.pad > 0px : Rectangle { height: 8px; }
        @children
    }
}

// 忙碌指示器：由 Slint 内建动画时钟 animation-tick() 驱动，无需外部定时器推进。
// 旋转的缺口圆弧，比单帧字符更像"正在旋转"的指示器。
component Spinner inherits Rectangle {
    in property <bool> running: false;
    // 允许调用方通过 width/height 覆盖尺寸
    width: 20px;
    height: 20px;
    // 动画相位：1s 一圈；仅在 running 时读取 animation-tick()，
    // 这样静止的 Spinner 不会持续请求重绘。
    private property <float> phase: root.running ? mod(animation-tick(), 1s) / 1s : 0;
    // 以下均为 100x100 viewbox 内的坐标
    private property <float> r: 40;
    // stroke-width 是元素空间的逻辑长度（不随 viewbox 缩放）
    private property <length> sw: 2.5px;
    visible: root.running;
    // 轨道浅环，让旋转的头部更易辨认
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        width: 100%;
        height: 100%;
        stroke-width: root.sw;
        stroke: ThemeG.border;
        MoveTo { x: 50; y: 10; }
        ArcTo { radius-x: 40; radius-y: 40; x: 50; y: 90; sweep: true; large-arc: false; }
    }
    // 旋转头部：约 1/4 圈弧长，起始角随时间前进
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        width: 100%;
        height: 100%;
        stroke-width: root.sw;
        stroke: ThemeG.accent;
        MoveTo {
            x: 50 + root.r * sin(360deg * root.phase);
            y: 50 - root.r * cos(360deg * root.phase);
        }
        ArcTo {
            radius-x: root.r;
            radius-y: root.r;
            x: 50 + root.r * sin(360deg * (root.phase + 0.25));
            y: 50 - root.r * cos(360deg * (root.phase + 0.25));
            sweep: true;
            large-arc: false;
        }
    }
}

component FieldLabel inherits Text {
    font-size: 12px;
    color: ThemeG.text-dim;
}

// 应用内确认弹窗：风格与整体 UI 一致、无系统提示音，锚定在触发元素（鼠标）附近
component ConfirmPop inherits PopupWindow {
    in property <string> title: "确认操作";
    in property <string> msg;
    in property <string> ok-label: "删除";
    callback confirmed;
    callback cancelled;
    close-policy: PopupClosePolicy.close-on-click-outside;
    // PopupWindow 必须显式给出宽高。
    //
    // 踩过的坑：只写 `card.width` 而完全不给高度时，弹出层的可用区域可能塌成
    // 一条窄缝 —— 文字还能看见一部分（那是 card 溢出绘制的结果），
    // 但按钮落在窗口之外，**鼠标移上去不会变手形、点了也没反应**，
    // 看起来就像「被别的控件遮住了」。
    // 这里给 card 一个明确高度，并让 PopupWindow 跟着 card 走。
    width: 360px;
    height: card.preferred-height;
    card := Rectangle {
        width: 320px;
        background: ThemeG.panel;
        border-radius: ThemeG.radius;
        border-width: 1px;
        border-color: ThemeG.border;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 700;
                color: ThemeG.text;
            }
            Text {
                text: root.msg;
                // 必须给固定宽度：只写 wrap 不约束宽度时，preferred-height 按
                // 单行估算，长文案换行后会溢出卡片的 height，把下面的按钮挤掉。
                width: 288px;
                font-size: 13px;
                color: ThemeG.text-dim;
                wrap: word-wrap;
            }
            Rectangle { height: 2px; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                PillBtn { label: "取消"; clicked => { root.close(); root.cancelled(); } }
                PillBtn { label: root.ok-label; danger: true; clicked => { root.close(); root.confirmed(); } }
            }
        }
    }
}

// 右键菜单项
component MenuItemBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked;
    height: 32px;
    border-radius: ThemeG.radius-s;
    background: mta.has-hover ? ThemeG.hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        MdlIcon {
            glyph: root.glyph;
            width: 16px;
            font-size: 12px;
            color: root.danger ? ThemeG.err : ThemeG.text-dim;
        }
        Text {
            text: root.label;
            font-size: 13px;
            color: root.danger ? ThemeG.err : ThemeG.text;
            vertical-alignment: center;
        }
    }
    mta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> sub: "";
    in property <color> tint: ThemeG.accent;
    background: ThemeG.panel;
    border-radius: ThemeG.radius;
    border-width: 1px;
    border-color: ThemeG.border;
    VerticalLayout {
        padding: 16px;
        alignment: start;
        Text { text: root.label; font-size: 12px; color: ThemeG.text-dim; }
        Rectangle { height: 6px; }
        HorizontalLayout {
            Rectangle { width: 4px; height: 22px; background: root.tint; border-radius: 2px; }
            Rectangle { width: 8px; }
            Text { text: root.value; font-size: 20px; font-weight: 700; color: ThemeG.text; vertical-alignment: center; }
        }
        if root.sub != "": Rectangle { height: 4px; }
        if root.sub != "": Text { text: root.sub; font-size: 11px; color: ThemeG.text-dim; }
    }
}

component SectionTitle inherits Text {
    font-size: 16px;
    font-weight: 600;
    color: ThemeG.text;
}

// 传输行（Dashboard / Transfers 复用）
component XferLine inherits Rectangle {
    in property <XferRow> xf;
    height: 40px;
    background: ThemeG.panel-2;
    border-radius: ThemeG.radius-s;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Rectangle {
            horizontal-stretch: 1;
            Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.xf.name;
                font-size: 12px;
                color: ThemeG.text;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        Text { text: root.xf.size; font-size: 12px; color: ThemeG.text-dim; width: 80px; vertical-alignment: center; }
        Text { text: root.xf.speed; font-size: 12px; color: ThemeG.accent; width: 90px; vertical-alignment: center; }
        Rectangle {
            width: 60px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 6px;
                    background: ThemeG.border;
                    border-radius: 3px;
                    Rectangle {
                        width: parent.width * root.xf.percent / 100;
                        height: 100%;
                        background: ThemeG.accent;
                        border-radius: 3px;
                    }
                }
            }
        }
    }
}

// ---------------- 视图 ----------------

component DashboardView inherits Rectangle {
    background: transparent;
    callback refresh;
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            // 统计行
            HorizontalLayout {
                spacing: 14px;
                height: 96px;
                StatTile {
                    label: "rclone 状态";
                    value: DashboardG.running ? "运行中" : (DashboardG.stale ? "已断开" : "未连接");
                    sub: DashboardG.running ? (DashboardG.managed ? "托管 · " + DashboardG.url : "外部 · " + DashboardG.url) : (DashboardG.stale ? "显示上次快照 · " + DashboardG.url : "未连接");
                    tint: DashboardG.running ? ThemeG.ok : (DashboardG.stale ? ThemeG.warn : ThemeG.err);
                }
                StatTile {
                    label: "传输速度";
                    value: DashboardG.speed;
                    sub: "任务 " + DashboardG.transfers + " 个";
                }
                StatTile {
                    label: "累计流量";
                    value: DashboardG.total-bytes;
                    sub: "错误 " + DashboardG.errors + " 次";
                    tint: ThemeG.warn;
                }
                StatTile {
                    label: "资源总览";
                    value: DashboardG.remotes + " 远程";
                    sub: "挂载 " + DashboardG.mounts + " 个";
                    tint: ThemeG.ok;
                }
            }
            HorizontalLayout {
                spacing: 14px;
                Card {
                    title: "正在传输";
                    horizontal-stretch: 2;
                    VerticalLayout {
                        spacing: 2px;
                        if DashboardG.xfers.length == 0 : Text {
                            text: "当前没有进行中的传输";
                            font-size: 13px;
                            color: ThemeG.text-dim;
                        }
                        for xf in DashboardG.xfers : XferLine { xf: xf; }
                    }
                }
                Card {
                    title: "系统信息";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            height: 20px;
                            Text { text: "版本"; font-size: 12px; color: ThemeG.text-dim; width: 64px; vertical-alignment: center; }
                            Text { text: DashboardG.version; font-size: 13px; color: ThemeG.text; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            height: 20px;
                            Text { text: "平台"; font-size: 12px; color: ThemeG.text-dim; width: 64px; vertical-alignment: center; }
                            Text { text: DashboardG.os-info; font-size: 13px; color: ThemeG.text; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            height: 20px;
                            Text { text: "RC 地址"; font-size: 12px; color: ThemeG.text-dim; width: 64px; vertical-alignment: center; }
                            Text { text: DashboardG.url; font-size: 12px; color: ThemeG.text; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
            // 历史记录：把每一次 toast（成功/失败/提示）留档。
            // toast 只显示 2.6 秒，操作失败时经常来不及看清；这里可回看、可清空。
            Card {
                title: "历史记录";
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        height: 26px;
                        Text {
                            text: ToastG.history.length == 0
                                ? "暂无记录"
                                : "共 " + ToastG.history.length + " 条"
                                  + (ToastG.has-errors ? " · 含错误" : "");
                            font-size: 12px;
                            color: ToastG.has-errors ? ThemeG.err : ThemeG.text-dim;
                            vertical-alignment: center;
                        }
                        Rectangle {}
                        // 右上角：清空。PillBtn 用自定义 disabled 属性（不是标准 enabled）
                        PillBtn {
                            label: "清空";
                            compact: true;
                            disabled: ToastG.history.length == 0;
                            clicked => {
                                ToastG.history = [];
                                ToastG.has-errors = false;
                            }
                        }
                    }
                    Rectangle {
                        height: 168px;
                        border-radius: ThemeG.radius-s;
                        background: ThemeG.panel-2;
                        border-width: 1px;
                        border-color: ThemeG.border;
                        ScrollView {
                            VerticalLayout {
                                padding: 8px;
                                spacing: 3px;
                                for l in ToastG.history : HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: l.time;
                                        font-size: 11px;
                                        color: ThemeG.text-dim;
                                        width: 60px;
                                        vertical-alignment: top;
                                    }
                                    // 左侧色条：绿=成功 / 红=错误 / 灰=信息
                                    Rectangle {
                                        width: 3px;
                                        background: l.kind == "2" ? ThemeG.err
                                            : (l.kind == "1" ? ThemeG.ok : ThemeG.text-dim);
                                        border-radius: 2px;
                                    }
                                    Text {
                                        text: l.msg;
                                        font-size: 12px;
                                        color: l.kind == "2" ? ThemeG.err
                                            : (l.kind == "1" ? ThemeG.ok : ThemeG.text);
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                        vertical-alignment: top;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component FilesView inherits Rectangle {
    background: transparent;
    callback refresh;
    callback open-row(int);
    callback go-up;
    callback mkdir;
    callback del-row(int);
    callback rename-row(int);
    callback copy-row(int);
    callback copy-link(int);
    // 右键菜单 / 弹窗所需的待操作状态
    property <int> op-idx: -1;
    property <string> op-name: "";
    property <bool> op-is-dir: false;
    property <length> menu-ax;
    property <length> menu-ay;
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 36px;
            ComboBox {
                width: 220px;
                model: FilesG.remotes;
                current-index <=> FilesG.remote-idx;
                changed current-index => {
                    FilesG.path = "";
                    root.refresh();
                }
            }
            Rectangle { width: 4px; }
            IconBtn { label: "\u{E74A}"; clicked => { root.go-up(); } }
            Rectangle {
                background: ThemeG.panel;
                border-radius: ThemeG.radius-s;
                border-width: 1px;
                border-color: ThemeG.border;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: FilesG.remote-idx >= 0 && FilesG.remotes.length > 0 ? FilesG.remotes[FilesG.remote-idx] + "/" + FilesG.path : "/";
                        font-size: 13px;
                        color: ThemeG.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Rectangle {}
            PillBtn { label: "新建文件夹"; clicked => { root.mkdir(); } }
            IconBtn { label: "\u{E72C}"; clicked => { root.refresh(); } }
        }
        Card {
            pad: 0px;
            fill: true;
            vertical-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 34px;
                    background: ThemeG.panel-2;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Rectangle {
                            horizontal-stretch: 1;
                            Text { text: "名称"; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        }
                        Text { text: "大小"; font-size: 12px; color: ThemeG.text-dim; width: 100px; vertical-alignment: center; }
                        Text { text: "修改时间"; font-size: 12px; color: ThemeG.text-dim; width: 170px; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for row[i] in FilesG.entries : Rectangle {
                            height: 38px;
                            background: FilesG.sel == i ? ThemeG.accent-soft : (ta.has-hover ? ThemeG.hover : transparent);
                            ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { FilesG.sel = i; FilesG.rename-name = row.name; }
                                double-clicked => { root.open-row(i); }
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                        FilesG.sel = i;
                                        FilesG.rename-name = row.name;
                                        root.op-idx = i;
                                        root.op-name = row.name;
                                        root.op-is-dir = row.is-dir;
                                        root.menu-ax = Math.max(0px, Math.min(self.absolute-position.x + self.mouse-x - root.absolute-position.x, root.width - 190px));
                                        root.menu-ay = Math.min(self.absolute-position.y + self.mouse-y - root.absolute-position.y, 120px);
                                        ctx.show();
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    MdlIcon {
                                        glyph: row.is-dir ? "\u{E8B7}" : "\u{E8A5}";
                                        x: 0;
                                        width: 20px;
                                        font-size: 14px;
                                        color: row.is-dir ? ThemeG.accent : ThemeG.text-dim;
                                    }
                                    Text {
                                        x: 26px;
                                        width: parent.width - 26px;
                                        height: parent.height;
                                        text: row.name;
                                        font-size: 13px;
                                        color: row.is-dir ? ThemeG.accent : ThemeG.text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: row.is-dir ? "—" : row.size; font-size: 12px; color: ThemeG.text-dim; width: 100px; vertical-alignment: center; }
                                Text { text: row.mtime; font-size: 12px; color: ThemeG.text-dim; width: 170px; vertical-alignment: center; }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: ThemeG.border;
                                opacity: 0.5;
                            }
                        }
                    }
                    // 加载遮罩：目录请求期间禁用文件点击 + spinner，防止拼出不存在的路径
                    if FilesG.loading : Rectangle {
                        background: #80808033;
                        block := TouchArea { }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Spinner { running: true; }
                            Text { text: "加载中…"; font-size: 12px; color: ThemeG.text; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
    // 右键菜单（原点击工具栏功能全部集成于此）
    ctx := PopupWindow {
        x: root.menu-ax;
        y: root.menu-ay;
        close-policy: PopupClosePolicy.close-on-click-outside;
        ctxcard := Rectangle {
            width: 170px;
            background: ThemeG.panel;
            border-radius: ThemeG.radius-s;
            border-width: 1px;
            border-color: ThemeG.border;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                MenuItemBtn {
                    glyph: "\u{E8AC}";
                    label: "重命名";
                    clicked => { ctx.close(); rnp.show(); }
                }
                MenuItemBtn {
                    glyph: "\u{E8C8}";
                    label: "复制一份";
                    clicked => { ctx.close(); root.copy-row(root.op-idx); }
                }
                if !root.op-is-dir : MenuItemBtn {
                    glyph: "\u{E71B}";
                    label: "复制直链";
                    clicked => { ctx.close(); root.copy-link(root.op-idx); }
                }
                MenuItemBtn {
                    glyph: "\u{E74D}";
                    label: "删除";
                    danger: true;
                    clicked => { ctx.close(); delp.show(); }
                }
            }
        }
    }
    // 重命名弹窗
    rnp := PopupWindow {
        x: root.menu-ax;
        y: root.menu-ay + 36px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        rnpcard := Rectangle {
            width: 400px;
            background: ThemeG.panel;
            border-radius: ThemeG.radius;
            border-width: 1px;
            border-color: ThemeG.border;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                FieldLabel { text: "重命名 " + root.op-name; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        width: 240px;
                        text <=> FilesG.rename-name;
                        accepted(t) => { rnp.close(); root.rename-row(root.op-idx); }
                    }
                    PillBtn { label: "确定"; primary: true; clicked => { rnp.close(); root.rename-row(root.op-idx); } }
                    PillBtn { label: "取消"; clicked => { rnp.close(); } }
                }
            }
        }
    }
    // 删除确认弹窗
    delp := ConfirmPop {
        title: "删除";
        msg: "确认删除 " + root.op-name + (root.op-is-dir ? "（文件夹将整体删除）？" : "？");
        x: root.menu-ax;
        y: root.menu-ay;
        confirmed => { root.del-row(root.op-idx); }
    }
}

component RemotesView inherits Rectangle {
    background: transparent;
    // 窗口可视高度（由 MainWindow 传入）。
    // 不能用 `root.height`：本组件在整页 ScrollView 里，root.height 是**内容**高度，
    // 用它限制弹窗纵坐标等于没限制，弹窗会一直被窗口底边裁掉。
    in property <length> viewport-h: 720px;
    callback refresh;
    callback filter-changed(string);
    callback add;
    callback edit-row(int);
    callback del-row(int);
    callback editor-save;
    callback editor-cancel;
    callback type-changed;
    // 代理
    callback proxy-changed(string, int);
    callback proxy-add();
    callback proxy-edit(string);
    callback proxy-save();
    callback proxy-cancel();
    callback proxy-del(string);
    callback proxy-del-confirm(string);
    callback proxy-refresh();
    // 删除确认弹窗所需的待操作状态
    property <int> del-idx: -1;
    property <string> del-name: "";
    property <length> pop-ax;
    property <length> pop-ay;
    // 整页滚动（与 MountsView 一致）：
    // 远程页内容会随「编辑器展开 / 代理表单展开 / 远程变多」持续变高，
    // 一旦总高超出窗口，固定布局就会把靠下的卡片压扁甚至裁掉（面板底部看不见、
    // 按钮被切掉、ScrollView 也拿不到可滚动的高度）。
    // 让整页滚动后，每张卡片都按内容自然高度排版，滚一下就能看到全部。
    ScrollView {
    VerticalLayout {
        width: root.width;
        padding: 24px;
        spacing: 14px;
        // 工具条
        HorizontalLayout {
            spacing: 8px;
            height: 36px;
            LineEdit {
                width: 220px;
                text <=> RemotesG.filter;
                placeholder-text: "搜索远程名称";
                edited(t) => { root.filter-changed(t); }
            }
            PillBtn { label: "刷新"; clicked => { root.refresh(); } }
            // 忙碌指示：任何异步操作（刷新 / 应用导入 / 下发代理）期间可见，
            // 让用户知道「正在做什么」，而不是点完没反应。
            if RemotesG.loading : HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Spinner { width: 18px; height: 18px; running: true; }
                }
                Text {
                    text: "处理中…";
                    font-size: 12px;
                    color: ThemeG.text-dim;
                    vertical-alignment: center;
                }
            }
            Rectangle {}
            PillBtn { label: "＋ 新建远程"; primary: true; clicked => { root.add(); } }
        }
        // 编辑器
        if RemotesG.show-editor : Card {
            title: RemotesG.edit-is-new ? "新建远程存储" : "编辑远程存储：" + RemotesG.edit-name;
            VerticalLayout {
                spacing: 10px;
                // 名称 + 类型
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "名称（英文，不含空格或冒号）"; }
                        LineEdit { text <=> RemotesG.edit-name; enabled: RemotesG.edit-is-new; }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 180px;
                        FieldLabel { text: "类型"; }
                        ComboBox {
                            model: RemotesG.types;
                            current-index <=> RemotesG.type-idx;
                            enabled: RemotesG.edit-is-new;
                            selected(t) => { root.type-changed(); }
                        }
                    }
                }
                // 类型描述
                if RemotesG.provider-desc != "" : Text {
                    text: RemotesG.provider-desc;
                    font-size: 12px;
                    color: ThemeG.text-dim;
                    wrap: word-wrap;
                }
                // 参数字段（模板驱动）
                if RemotesG.edit-fields.length > 0 && !RemotesG.show-raw : Rectangle {
                    border-radius: ThemeG.radius-s;
                    border-width: 1px;
                    border-color: ThemeG.border;
                    background: ThemeG.panel-2;
                    height: 260px;
                    ScrollView {
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            for f[i] in RemotesG.edit-fields : VerticalLayout {
                                spacing: 2px;
                                if !f.is-advanced || RemotesG.show-advanced : VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 30px;
                                        // 标签
                                        Text {
                                            text: f.label + (f.required ? " *" : "");
                                            font-size: 12px;
                                            color: f.required ? ThemeG.text : ThemeG.text-dim;
                                            width: 180px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        // 输入控件
                                        if f.kind == "bool" : CheckBox {
                                            checked: f.value == "true";
                                            toggled => {
                                                RemotesG.edit-fields[i].value = self.checked ? "true" : "false";
                                            }
                                        }
                                        if f.kind != "bool" : LineEdit {
                                            horizontal-stretch: 1;
                                            text: f.value;
                                            input-type: f.kind == "password" ? InputType.password : InputType.text;
                                            edited(t) => {
                                                RemotesG.edit-fields[i].value = t;
                                            }
                                        }
                                    }
                                    // 帮助文本：置于输入框下方，超长自动换行
                                    if f.kind != "bool" && f.help != "" : HorizontalLayout {
                                        Rectangle { width: 188px; }
                                        Text {
                                            text: f.help;
                                            font-size: 11px;
                                            color: ThemeG.text-dim;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // 高级选项 + 原始编辑器切换
                HorizontalLayout {
                    spacing: 12px;
                    height: 28px;
                    if RemotesG.edit-fields.length > 0 : TouchArea {
                        mouse-cursor: pointer;
                        clicked => { RemotesG.show-advanced = !RemotesG.show-advanced; }
                        Text {
                            text: RemotesG.show-advanced ? "▾ 隐藏高级选项" : "▸ 显示高级选项";
                            font-size: 12px;
                            color: ThemeG.accent;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {}
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { RemotesG.show-raw = !RemotesG.show-raw; }
                        Text {
                            text: RemotesG.show-raw ? "切换到表单模式" : "切换到原始模式";
                            font-size: 12px;
                            color: ThemeG.accent;
                            vertical-alignment: center;
                        }
                    }
                }
                // 原始 key=value 编辑器（保留给高级用户）
                if RemotesG.show-raw || RemotesG.edit-fields.length == 0 : VerticalLayout {
                    spacing: 3px;
                    FieldLabel { text: "参数（每行一个 key=value，保存时将覆盖已有同名参数）"; }
                    Rectangle {
                        height: 140px;
                        background: ThemeG.panel-2;
                        border-radius: ThemeG.radius-s;
                        border-width: 1px;
                        border-color: ThemeG.border;
                        TextEdit { text <=> RemotesG.edit-params; font-size: 12px; }
                    }
                }
                // 按钮
                HorizontalLayout {
                    spacing: 8px;
                    PillBtn { label: "保存"; primary: true; clicked => { root.editor-save(); } }
                    PillBtn { label: "取消"; clicked => { root.editor-cancel(); } }
                    Rectangle {}
                }
            }
        }
        // 列表
        // 整页滚动下不能用 `fill: true` / `vertical-stretch: 1`（那是给固定布局
        // 「撑满剩余空间」用的）：在 ScrollView 里它们会让高度计算变成循环依赖。
        // 改为按行数估算固定高度，超出由页面滚动承载。
        //
        // 踩过的坑（实测）：卡片高度按行数算好了，但列表容器只写
        // `vertical-stretch: 1` —— Card 内部 VerticalLayout 的对齐方式是
        // `start`（只有 fill: true 才是 stretch），拉伸拿不到任何剩余空间，
        // 列表塌成一行：标题写着「远程存储（4）」，列表里只画出第一条，
        // 而且因为 ListView 视口只有一行高，滚轮也滚不动。
        // 因此这里**两个高度都必须由 rows.length 推导**，不依赖布局结果。
        Card {
            title: "远程存储（" + RemotesG.rows.length + "）";
            pad: 0px;
            // 高度 = 卡片标题行 36 + 表头行 36 + 每行 40 + 2（上下边框）。
            // 标题行是 Card 内建的，容易被漏掉：只算一个 36 会让最后一行被裁。
            // 列表最多 9 行（360）高，再多由列表内部滚动。
            height: 74px + Math.min(360px, Math.max(40px, RemotesG.rows.length * 40px));
            VerticalLayout {
                Rectangle {
                    height: 36px;
                    background: ThemeG.panel-2;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Rectangle {
                            horizontal-stretch: 1;
                            Text { text: "名称"; width: 100%; font-size: 12px; color: ThemeG.text-dim; horizontal-alignment: left; vertical-alignment: center; }
                        }
                        Text { text: "类型"; font-size: 12px; color: ThemeG.text-dim; width: 110px; vertical-alignment: center; }
                        Text { text: "用量"; font-size: 12px; color: ThemeG.text-dim; width: 140px; vertical-alignment: center; }
                        Text { text: "代理"; font-size: 12px; color: ThemeG.text-dim; width: 240px; vertical-alignment: center; }
                        Text { text: "操作"; font-size: 12px; color: ThemeG.text-dim; width: 150px; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    // 必须显式给高度，理由见上面的注释（vertical-stretch 拿不到空间）。
                    height: Math.min(360px, Math.max(40px, RemotesG.rows.length * 40px));
                    ListView {
                        for r[i] in RemotesG.rows : Rectangle {
                            height: 40px;
                            background: ta.has-hover ? ThemeG.hover : transparent;
                            ta := TouchArea { mouse-cursor: pointer; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                // 名称列（含「凭据未随包导出」徽标，徽标不占独立列，避免打乱表头对齐）
                                Rectangle {
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: r.name;
                                            font-size: 13px;
                                            color: ThemeG.text;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        // 徽标：垂直居中；悬停补充含义
                                        if r.needs-auth : VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                height: 20px;
                                                width: 132px;
                                                border-radius: ThemeG.radius-s;
                                                background: ThemeG.panel-2;
                                                border-width: 1px;
                                                border-color: ThemeG.border;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: bah.has-hover ? "可能需要重新认证" : "凭据未随包导出";
                                                        font-size: 11px;
                                                        color: ThemeG.warn;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                bah := TouchArea { mouse-cursor: help; }
                                            }
                                        }
                                    }
                                }
                                Text { text: r.rtype; font-size: 13px; color: ThemeG.text-dim; width: 110px; vertical-alignment: center; overflow: elide; }
                                Text { text: r.usage; font-size: 12px; color: ThemeG.ok; width: 140px; vertical-alignment: center; overflow: elide; }
                                // 代理列：状态徽标 + 目标 + 下拉框
                                // 「不代理」不等于强制直连，悬停说明写在下拉的 tooltip 里
                                HorizontalLayout {
                                    width: 240px;
                                    spacing: 6px;
                                    alignment: start;
                                    if r.proxy-conflict : Rectangle {
                                        height: 18px;
                                        width: 52px;
                                        border-radius: ThemeG.radius-s;
                                        background: ThemeG.panel-2;
                                        border-width: 1px;
                                        border-color: ThemeG.warn;
                                        Text {
                                            text: "待修复";
                                            font-size: 10px;
                                            color: ThemeG.warn;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if !r.proxy-conflict && r.proxy-pending : Rectangle {
                                        height: 18px;
                                        width: 52px;
                                        border-radius: ThemeG.radius-s;
                                        background: ThemeG.panel-2;
                                        border-width: 1px;
                                        border-color: ThemeG.border;
                                        Text {
                                            text: "待应用";
                                            font-size: 10px;
                                            color: ThemeG.text-dim;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        ComboBox {
                                            model: RemotesG.proxy-options;
                                            // 索引由 Rust 侧算好（见 proxy-index），Slint 不做绑定解析
                                            current-index: r.proxy-index;
                                            selected(t) => { root.proxy-changed(r.name, self.current-index); }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    width: 150px;
                                    spacing: 6px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        PillBtn { label: "编辑"; compact: true; clicked => { root.edit-row(i); } }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        PillBtn {
                                            label: "删除";
                                            compact: true;
                                            danger: true;
                                            clicked => {
                                                root.del-idx = i;
                                                root.del-name = r.name;
                                                root.pop-ax = Math.max(0px, Math.min(self.absolute-position.x - root.absolute-position.x + self.width / 2 - 160px, root.width - 324px));
                                                // 弹窗锚在按钮下方；靠近窗口底部时必须往上收，否则
                                                // 按钮会被窗口底边裁掉（实测：代理配置卡片在页面底部，
                                                // 「删除代理」的确认框只剩标题和正文，确认/取消点不到）。
                                                root.pop-ay = Math.max(0px, Math.min(self.absolute-position.y - root.absolute-position.y + self.height + 4px, root.viewport-h - 216px));
                                                delp.show();
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: ThemeG.border;
                                opacity: 0.5;
                            }
                        }
                    }
                }
            }
        }
        // ---------------- 代理配置管理 ----------------
        // 布局要点（踩过的坑）：
        // - 不要设 `vertical-stretch: 0`，也不要给内部 ScrollView：
        //   远程页已整体滚动，这张卡片按内容自然展开即可。
        // - 之前给它限高 + 内部 ScrollView，结果卡片参与外层高度分配被压扁，
        //   ScrollView 拿不到高度，底部按钮直接被裁掉、完全点不到。
        Card {
            title: "代理配置（" + RemotesG.proxy-rows.length + "）";
            VerticalLayout {
                spacing: 8px;
                // 说明：必须写清四件事，否则用户会误判功能边界
                Text {
                    text: "按远程分配代理。「不代理」= 不设置 RCGUI 的远程级代理，rclone 仍可能继承系统的 HTTP_PROXY / HTTPS_PROXY 环境变量，不等于强制直连。代理只在远程建立连接时生效：正在运行的挂载/服务需要重新挂载或重启才会使用新代理。实测限制：ftp / sftp 两类远程不读取本程序的代理设置（rclone 后端不认 override.http_proxy），给它们选代理不会生效，详见 docs/proxy-verification.md。";
                    font-size: 11px;
                    color: ThemeG.text-dim;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    height: 30px;
                    PillBtn { label: "＋ 新建代理配置"; primary: true; clicked => { root.proxy-add(); } }
                    PillBtn { label: "刷新"; clicked => { root.proxy-refresh(); } }
                    Rectangle {}
                }
                // 编辑表单：分三行，避免控件在同一行争宽度。
                //
                // ⚠️ 关键约束：Fluent 的 `LineEdit` / `ComboBox` **自带 min-width: 160px**。
                // 因此任何承载它们的列都至少要 160px 宽，否则控件会比分配到的空间更宽，
                // 直接**溢出到卡片外面**（本次代理配置右侧超出就是这么来的）。
                // 下面每个固定列都 >= 160px，弹性列给 min-width 兜底。
                if RemotesG.proxy-show-editor : VerticalLayout {
                    spacing: 12px;
                    // 第 1 行：名称（弹性）+ 协议（固定 170px ≥ 160）
                    HorizontalLayout {
                        spacing: 12px;
                        height: 54px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            min-width: 180px;
                            FieldLabel { text: "名称"; }
                            LineEdit { text <=> RemotesG.proxy-edit-name; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            width: 170px;
                            FieldLabel { text: "协议"; }
                            ComboBox {
                                model: RemotesG.proxy-protocols;
                                current-index <=> RemotesG.proxy-edit-proto;
                            }
                        }
                    }
                    // 第 2 行：地址（弹性）+ 端口（固定 170px ≥ 160）
                    HorizontalLayout {
                        spacing: 12px;
                        height: 54px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            min-width: 220px;
                            FieldLabel { text: "地址（主机名或 IP，IPv6 不要加方括号）"; }
                            LineEdit { text <=> RemotesG.proxy-edit-host; placeholder-text: "127.0.0.1 或 proxy.corp.local"; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            width: 170px;
                            FieldLabel { text: "端口"; }
                            LineEdit { text <=> RemotesG.proxy-edit-port; input-type: InputType.number; }
                        }
                    }
                    // 第 3 行：用户名 + 密码（各占一半）
                    HorizontalLayout {
                        spacing: 12px;
                        height: 54px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            min-width: 170px;
                            FieldLabel { text: "用户名（可选）"; }
                            LineEdit { text <=> RemotesG.proxy-edit-user; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            min-width: 170px;
                            FieldLabel { text: "密码（可选）"; }
                            LineEdit { text <=> RemotesG.proxy-edit-pass; input-type: InputType.password; }
                        }
                    }
                    Text {
                        text: "凭据会以明文（百分号编码）写入 rclone.conf，不是加密；导出 rcgui.conf 时默认不包含，导入后需要重新填写。";
                        font-size: 11px;
                        color: ThemeG.warn;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        PillBtn { label: "保存"; primary: true; clicked => { root.proxy-save(); } }
                        PillBtn { label: "取消"; clicked => { root.proxy-cancel(); } }
                        Rectangle {}
                    }
                }
                // 配置列表：表头与数据行使用**完全相同**的列宽，避免错位。
                // 「目标」列是唯一弹性列，其余固定宽度。
                // 注意：Slint 不允许同一元素同时写 width 和 min-width，
                // 因此固定列只给 width（它不会被压到 0，弹性列会先让出空间）。
                if RemotesG.proxy-rows.length > 0 : Rectangle {
                    height: 34px;
                    background: ThemeG.panel-2;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 4px;
                        Text { text: "名称"; width: 140px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "协议"; width: 76px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "目标"; horizontal-stretch: 1; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; }
                        Text { text: "凭据"; width: 64px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "使用中的远程"; width: 160px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; }
                        Text { text: "操作"; width: 130px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                    }
                }
                if RemotesG.proxy-rows.length > 0 : VerticalLayout {
                    for p[i] in RemotesG.proxy-rows : Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 4px;
                            Text { text: p.name; width: 140px; font-size: 12px; color: ThemeG.text; vertical-alignment: center; overflow: elide; }
                            Text { text: p.protocol; width: 76px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                            Text { text: p.target; horizontal-stretch: 1; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; }
                            Text { text: p.auth; width: 64px; font-size: 12px; color: ThemeG.warn; vertical-alignment: center; }
                            Text { text: p.used-by; width: 160px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; }
                            HorizontalLayout {
                                width: 130px;
                                spacing: 6px;
                                alignment: start;
                                PillBtn { label: "编辑"; compact: true; clicked => { root.proxy-edit(p.id); } }
                                PillBtn { label: "删除"; compact: true; danger: true; clicked => { root.proxy-del(p.id); } }
                            }
                        }
                    }
                }
                // 删除确认：被 remote 使用时必须提示关联，而不是默默删掉
                if RemotesG.proxy-del-show : Rectangle {
                    border-radius: ThemeG.radius-s;
                    background: ThemeG.panel-2;
                    border-width: 1px;
                    border-color: ThemeG.err;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: "删除代理配置「" + RemotesG.proxy-del-name + "」？";
                            font-size: 13px;
                            color: ThemeG.text;
                            wrap: word-wrap;
                        }
                        if RemotesG.proxy-del-affected != "" : Text {
                            text: RemotesG.proxy-del-affected + "。这些远程的代理会被恢复成原状（我们不会删除你原本设置的值）。";
                            font-size: 12px;
                            color: ThemeG.warn;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "若该远程有正在运行的挂载或服务，需要重新挂载/重启才会丢掉旧代理。";
                            font-size: 11px;
                            color: ThemeG.text-dim;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            height: 30px;
                            PillBtn { label: "确认删除"; danger: true; clicked => { RemotesG.proxy-del-show = false; root.proxy-del-confirm(RemotesG.proxy-del-id); } }
                            PillBtn { label: "取消"; clicked => { RemotesG.proxy-del-show = false; } }
                            Rectangle {}
                        }
                    }
                }
            }               // 卡片 VerticalLayout
        }                   // Card
    }                       // 页面 VerticalLayout
    }                       // ScrollView（整页滚动）
    // 删除确认弹窗（锚定在删除按钮附近）
    delp := ConfirmPop {
        title: "删除远程";
        msg: "确认删除远程存储 " + root.del-name + "？";
        x: root.pop-ax;
        y: root.pop-ay;
        confirmed => { root.del-row(root.del-idx); }
    }
}

component MountsView inherits Rectangle {
    background: transparent;
    callback refresh;
    callback add;
    callback remove(string);
    callback browse;
    callback path-nav(string);
    callback search-changed(string);
    ScrollView {
    VerticalLayout {
        width: root.width;
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            Text { text: "把远程仓库挂载为本地磁盘（需要 WinFsp）"; font-size: 13px; color: ThemeG.text-dim; vertical-alignment: center; }
            Rectangle {}
            LineEdit {
                width: 220px;
                text <=> MountsG.search;
                placeholder-text: "搜索本地/远程路径";
                edited(t) => { root.search-changed(t); }
            }
            IconBtn { label: "\u{E72C}"; clicked => { root.refresh(); } }
        }
        if !MountsG.winfsp-ok : Rectangle {
            height: 56px;
            background: ThemeG.panel;
            border-radius: ThemeG.radius;
            border-width: 1px;
            border-color: ThemeG.warn;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                Text { text: "⚠"; font-size: 16px; vertical-alignment: center; }
                Text { text: MountsG.winfsp-msg; font-size: 12px; color: ThemeG.warn; wrap: word-wrap; vertical-alignment: center; }
            }
        }
        Card {
            title: "新建挂载";
            VerticalLayout {
                spacing: 10px;
                // 第一行：仓库 + 子路径 + 挂载点
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        width: 180px;
                        FieldLabel { text: "仓库（远程）"; }
                        ComboBox {
                            model: MountsG.remotes;
                            current-index <=> MountsG.remote-idx;
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "仓库内子路径（留空 = 仓库根目录）"; }
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit { text <=> MountsG.sub-path; placeholder-text: "例如 movies/2024，留空为根"; horizontal-stretch: 1; }
                            IconBtn {
                                label: "\u{E838}";
                                clicked => { root.browse(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 180px;
                        FieldLabel { text: "挂载点（盘符 / * 自动）"; }
                        LineEdit { text <=> MountsG.new-point; }
                    }
                }
                // 第二行：缓存模式 + 只读 + 自动挂载 + 挂载按钮
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        width: 160px;
                        FieldLabel { text: "缓存模式"; }
                        ComboBox {
                            model: MountsG.caches;
                            current-index <=> MountsG.cache-idx;
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 100px;
                        FieldLabel { text: "只读"; }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            CheckBox { checked <=> MountsG.ro; }
                            Rectangle {}
                        }
                    }
                    Rectangle {}
                    VerticalLayout {
                        spacing: 3px;
                        width: 96px;
                        FieldLabel { text: " "; }
                        PillBtn { label: "挂载"; primary: true; disabled: MountsG.busy; clicked => { root.add(); } }
                    }
                }
                FieldLabel { text: "挂载是即时操作：只在点击「挂载」时通过 rclone RC 执行，不会在下次启动时自动执行。"; }
            }
        }
        // 挂载预设列表已移除：挂载是即时操作，配置通过 rcgui.conf 导入后直接应用到本地 rclone
        Card {
            title: "活动挂载（" + MountsG.mounts.length + "）";
            VerticalLayout {
                spacing: 2px;
                if MountsG.mounts.length == 0 : Text {
                    text: "暂无活动挂载";
                    font-size: 13px;
                    color: ThemeG.text-dim;
                }
                // 表头（与下方表单项使用相同宽度与对齐）
                if MountsG.mounts.length > 0 : Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { text: "本地路径"; width: 90px; font-size: 12px; color: ThemeG.text-dim; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "远程路径"; horizontal-stretch: 1; font-size: 12px; color: ThemeG.text-dim; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "操作"; width: 140px; font-size: 12px; color: ThemeG.text-dim; horizontal-alignment: left; vertical-alignment: center; }
                    }
                }
                for m[i] in MountsG.mounts : Rectangle {
                    height: 44px;
                    background: m.pending ? ThemeG.accent-soft : ThemeG.panel-2;
                    border-radius: ThemeG.radius-s;
                    border-width: m.pending ? 1px : 0px;
                    border-color: ThemeG.accent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { text: m.mount-point; font-size: 15px; font-weight: 700; color: ThemeG.accent; width: 90px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                        Text { text: m.fs; font-size: 13px; color: ThemeG.text; horizontal-stretch: 1; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                        HorizontalLayout {
                            width: 140px;
                            spacing: 6px;
                            alignment: start;
                            // 用 if 而非 visible：visible:false 仍占布局空间，会把按钮挤出列宽
                            if m.pending : VerticalLayout { alignment: center; Spinner { running: true; } }
                            VerticalLayout { alignment: center; PillBtn { label: "卸载"; compact: true; danger: true; disabled: m.pending; clicked => { root.remove(m.mount-point); } } }
                        }
                    }
                }
            }
        }
    }
    }
}

component ServesView inherits Rectangle {
    background: transparent;
    callback refresh;
    callback start;
    callback stop(string);
    callback browse;
    callback path-nav(string);
    callback search-changed(string);
    ScrollView {
    VerticalLayout {
        width: root.width;
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            Text { text: "网络服务（将远程以 WebDAV/SFTP 等方式共享到局域网）"; font-size: 13px; color: ThemeG.text-dim; vertical-alignment: center; }
            Rectangle {}
            LineEdit {
                width: 220px;
                text <=> ServesG.search;
                placeholder-text: "搜索 ID / 服务名称";
                edited(t) => { root.search-changed(t); }
            }
            IconBtn { label: "\u{E72C}"; clicked => { root.refresh(); } }
        }
        Card {
            title: "新建服务";
            VerticalLayout {
                spacing: 10px;
                // 第一行：服务名称 + 协议 + 仓库
                // 注意：Fluent 的 LineEdit/ComboBox 有 min-width: 160px，
                // 因此这里给每个字段留足 >=160px，否则会被挤压重叠。
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        width: 180px;
                        FieldLabel { text: "服务名称"; }
                        LineEdit { text <=> ServesG.svc-name; placeholder-text: "Serve_01"; }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 180px;
                        FieldLabel { text: "协议"; }
                        ComboBox {
                            model: ServesG.types;
                            current-index <=> ServesG.type-idx;
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 200px;
                        FieldLabel { text: "仓库（远程）"; }
                        ComboBox {
                            model: ServesG.remotes;
                            current-index <=> ServesG.remote-idx;
                        }
                    }
                    Rectangle {}
                }
                // 第二行：子路径 + 监听地址
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "子路径（留空 = 根）"; }
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit { text <=> ServesG.sub-path; placeholder-text: "share/docs"; horizontal-stretch: 1; }
                            IconBtn {
                                label: "\u{E838}";
                                clicked => { root.browse(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 220px;
                        FieldLabel { text: "监听地址"; }
                        LineEdit { text <=> ServesG.addr; }
                    }
                }
                // 第三行：用户 + 密码 + 启动按钮
                HorizontalLayout {
                    spacing: 12px;
                    height: 56px;
                    VerticalLayout {
                        spacing: 3px;
                        width: 160px;
                        FieldLabel { text: "用户（可选）"; }
                        LineEdit { text <=> ServesG.user; }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        width: 160px;
                        FieldLabel { text: "密码（可选）"; }
                        LineEdit { text <=> ServesG.pass; input-type: InputType.password; }
                    }
                    Rectangle {}
                    Spinner { running: ServesG.busy; }
                    VerticalLayout {
                        spacing: 3px;
                        width: 96px;
                        FieldLabel { text: " "; }
                        PillBtn { label: "启动"; primary: true; disabled: ServesG.busy; clicked => { root.start(); } }
                    }
                }
                FieldLabel { text: "启动是即时操作：只在点击「启动」时通过 rclone RC 执行，不会在下次启动时自动执行。"; }
            }
        }
        // 服务预设列表已移除：服务是即时操作，配置通过 rcgui.conf 导入后直接应用到本地 rclone
        Card {
            title: "运行中服务（" + ServesG.rows.length + "）";
            pad: 0px;
            fill: true;
            vertical-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 36px;
                    background: ThemeG.panel-2;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Rectangle {
                            horizontal-stretch: 1;
                            Text { text: "服务名称"; font-size: 12px; color: ThemeG.text-dim; width: parent.width; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                        }
                        Text { text: "ID"; font-size: 12px; color: ThemeG.text-dim; width: 190px; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "协议"; font-size: 12px; color: ThemeG.text-dim; width: 90px; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "远程"; font-size: 12px; color: ThemeG.text-dim; width: 170px; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "地址"; font-size: 12px; color: ThemeG.text-dim; width: 150px; horizontal-alignment: left; vertical-alignment: center; }
                        Text { text: "操作"; font-size: 12px; color: ThemeG.text-dim; width: 90px; horizontal-alignment: left; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for s[i] in ServesG.rows : Rectangle {
                            height: 40px;
                            background: ta.has-hover ? ThemeG.hover : transparent;
                            ta := TouchArea { mouse-cursor: pointer; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Text { text: s.name; font-size: 12px; color: ThemeG.text; width: parent.width; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                }
                                Text { text: s.id; font-size: 12px; color: ThemeG.text-dim; width: 190px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                Text { text: s.stype; font-size: 12px; color: ThemeG.text-dim; width: 90px; horizontal-alignment: left; vertical-alignment: center; }
                                Text { text: s.fs; font-size: 12px; color: ThemeG.text; width: 170px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                Text { text: s.addr; font-size: 12px; color: ThemeG.ok; width: 150px; horizontal-alignment: left; vertical-alignment: center; }
                                HorizontalLayout {
                                    width: 90px;
                                    VerticalLayout { alignment: center; PillBtn { label: "停止"; compact: true; danger: true; clicked => { root.stop(s.id); } } }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: ThemeG.border;
                                opacity: 0.5;
                            }
                        }
                    }
                }
            }
        }
    }
    }
}

// 标签小胶囊（后台任务标签用）
component TagPill inherits Rectangle {
    in property <string> label;
    in property <color> tint: ThemeG.accent;
    height: 22px;
    border-radius: 4px;
    background: ThemeG.panel-2;
    border-width: 1px;
    border-color: root.tint;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-size: 11px;
            color: root.tint;
            vertical-alignment: center;
        }
    }
    @children
}

component TransfersView inherits Rectangle {
    background: transparent;
    callback refresh;
    callback hide-done-changed;
    callback task-search(string);
    callback limit-apply();                  // 应用全局限速（tx:rx）
    callback job-stop(int);

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 34px;
            Text { text: "传输"; font-size: 16px; font-weight: 700; color: ThemeG.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            LineEdit {
                width: 200px;
                text <=> TransfersG.task-search;
                placeholder-text: "搜索任务";
                edited(t) => { root.task-search(t); }
            }
            CheckBox {
                text: "隐藏已完成任务";
                checked <=> TransfersG.hide-done;
                toggled => { root.hide-done-changed(); }
            }
            IconBtn { label: "\u{E72C}"; clicked => { root.refresh(); } }
        }
        if TransfersG.effective != "" : Text {
            text: "当前生效的全局限速：" + TransfersG.effective;
            font-size: 12px;
            color: ThemeG.text-dim;
        }

        // ---------- 网速监控 + 全局限速（rclone 仅支持全局 tx:rx） ----------
        Card {
            title: "网速与限速";
            fill: false;
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 24px;
                    Text { text: "上传 ↑ " + TransfersG.up-speed; font-size: 13px; color: ThemeG.accent; vertical-alignment: center; }
                    Text { text: "下载 ↓ " + TransfersG.down-speed; font-size: 13px; color: ThemeG.ok; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                // 限速：分两行，避免与内置控件 min-width:160px 冲突导致挤压
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "上传限速"; width: 64px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                    LineEdit {
                        width: 180px;
                        text <=> TransfersG.up-limit;
                        placeholder-text: "不限";
                    }
                    ComboBox {
                        width: 160px;
                        model: TransfersG.units;
                        current-index <=> TransfersG.up-unit;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "下载限速"; width: 64px; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                    LineEdit {
                        width: 180px;
                        text <=> TransfersG.down-limit;
                        placeholder-text: "不限";
                    }
                    ComboBox {
                        width: 160px;
                        model: TransfersG.units;
                        current-index <=> TransfersG.down-unit;
                    }
                    PillBtn { label: "应用限速"; primary: true; compact: true; clicked => { root.limit-apply(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // ---------- 后台任务 ----------
        Card {
            title: "后台任务（" + TransfersG.tasks.length + "）";
            pad: 0px;
            fill: true;
            vertical-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 36px;
                    background: ThemeG.panel-2;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        Text { text: "任务ID"; width: 90px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "标签"; horizontal-stretch: 1; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "状态"; width: 90px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "耗时"; width: 100px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "速度"; width: 100px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "操作"; width: 64px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for t[i] in TransfersG.tasks : Rectangle {
                            height: 42px;
                            background: hit2.has-hover ? ThemeG.hover : transparent;
                            hit2 := TouchArea { mouse-cursor: pointer; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                Text { text: "#" + t.id; width: 90px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                    if t.op != "" : TagPill { label: t.op; tint: t.op == "上传" ? ThemeG.ok : ThemeG.accent; }
                                    if t.remote != "" : TagPill {
                                        label: t.remote;
                                        tint: ThemeG.text-dim;
                                        Tooltip { text: @markdown("\{t.path}"); }
                                    }
                                    if t.svc != "" : TagPill { label: t.svc; tint: ThemeG.warn; }
                                        }
                                    }
                                }
                                Text { text: t.status; width: 90px; horizontal-alignment: left; font-size: 12px; color: t.status == "运行中" ? ThemeG.accent : (t.status == "失败" ? ThemeG.err : ThemeG.text-dim); vertical-alignment: center; }
                                Text { text: t.duration; width: 100px; horizontal-alignment: left; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                                Text { text: t.speed; width: 100px; horizontal-alignment: left; font-size: 12px; color: ThemeG.accent; vertical-alignment: center; }
                                HorizontalLayout {
                                    width: 64px;
                                    VerticalLayout { alignment: center; if !t.done : PillBtn { label: "停止"; compact: true; danger: true; clicked => { root.job-stop(t.id); } } }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ThemeG.border; opacity: 0.5; }
                        }
                    }
                }
            }
        }
    }
}

component PluginsView inherits Rectangle {
    background: transparent;
    // 同 RemotesView：弹窗纵坐标要按窗口可视高度收，不能用内容高度。
    in property <length> viewport-h: 720px;
    callback rescan;
    callback save-config;
    callback add-root;
    callback del-root(int);
    callback root-default(int);
    callback add-token;
    callback revoke-token(int);
    callback copy-token(string);
    callback images-refresh;
    callback image-del(int);
    callback copy-url(int);
    callback plugin-toggle(int);
    callback add-from-file;
    callback add-from-dir;
    callback open-dir;
    // 确认弹窗所需的待操作状态
    property <int> tok-idx: -1;
    property <string> tok-name: "";
    property <int> img-idx: -1;
    property <string> img-path: "";
    property <length> pop-ax;
    property <length> pop-ay;
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            // ---- 顶部操作栏：添加插件 + 刷新 ----
            Card {
                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        height: 32px;
                        spacing: 10px;
                        Text {
                            text: "插件目录：" + PluginsG.dir;
                            font-size: 12px;
                            color: ThemeG.text-dim;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {}
                        PillBtn { label: "从文件添加"; primary: true; compact: true; clicked => { root.add-from-file(); } }
                        PillBtn { label: "从文件夹添加"; compact: true; clicked => { root.add-from-dir(); } }
                        PillBtn { label: "打开目录"; compact: true; clicked => { root.open-dir(); } }
                        PillBtn { label: "刷新"; compact: true; clicked => { root.rescan(); } }
                    }
                    Text {
                        text: "支持 .zip 插件包或已解压的插件文件夹；放入插件目录后点「刷新」即可识别。新插件默认未启用，需手动勾选才会运行其入口文件。";
                        font-size: 11px;
                        color: ThemeG.text-dim;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                height: 24px;
                Text { text: "已安装插件（点击插件栏展开 / 收起）"; font-size: 13px; color: ThemeG.text-dim; vertical-alignment: center; }
                Rectangle {}
                IconBtn { label: "\u{E72C}"; clicked => { root.rescan(); } }
            }
            if PluginsG.rows.length == 0 : Card {
                Text { text: "未发现插件"; font-size: 13px; color: ThemeG.text-dim; }
            }
            for p[i] in PluginsG.rows : Rectangle {
                background: ThemeG.panel;
                border-radius: ThemeG.radius;
                border-width: 1px;
                border-color: PluginsG.expanded == i ? ThemeG.accent : ThemeG.border;
                clip: true;
                VerticalLayout {
                    alignment: start;
                    // ---- 卷帘头（始终显示；复选框固定于右侧中间） ----
                    Rectangle {
                        height: 56px;
                        background: PluginsG.expanded == i ? ThemeG.accent-soft : transparent;
                        hta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { PluginsG.expanded = PluginsG.expanded == i ? -1 : i; }
                        }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 12px;
                            MdlIcon {
                                glyph: p.kind == "package" ? "\u{E8B7}" : "\u{EA86}";
                                width: 22px;
                                font-size: 17px;
                                color: p.enabled ? ThemeG.accent : ThemeG.text-dim;
                            }
                            Text { text: p.name; font-size: 14px; font-weight: 600; color: p.enabled ? ThemeG.text : ThemeG.text-dim; vertical-alignment: center; }
                            Text { text: "v" + p.version; font-size: 11px; color: ThemeG.text-dim; vertical-alignment: center; }
                            // 类型 / 校验状态徽标
                            Rectangle {
                                height: 20px;
                                width: p.kind == "package" ? 52px : 44px;
                                border-radius: 10px;
                                background: p.kind == "package" ? ThemeG.panel-2 : ThemeG.accent-soft;
                                Text {
                                    text: p.kind == "package" ? "插件包" : "WASM";
                                    font-size: 10px;
                                    color: p.kind == "package" ? ThemeG.text-dim : ThemeG.accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            if p.kind == "package" && !p.verified : Rectangle {
                                height: 20px;
                                width: 52px;
                                border-radius: 10px;
                                background: ThemeG.err;
                                Text { text: "校验失败"; font-size: 10px; color: white; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                Text { text: p.desc; font-size: 12px; color: ThemeG.text-dim; width: parent.width; overflow: elide; vertical-alignment: center; }
                            }
                            Text { text: p.enabled ? "已启用" : "已停用"; font-size: 12px; color: p.enabled ? ThemeG.ok : ThemeG.text-dim; vertical-alignment: center; }
                            MdlIcon {
                                glyph: PluginsG.expanded == i ? "\u{E70E}" : "\u{E70D}";
                                width: 20px;
                                font-size: 13px;
                            }
                            CheckBox {
                                checked: p.enabled;
                                enabled: p.verified;
                                toggled => { root.plugin-toggle(i); }
                            }
                        }
                    }
                    // ---- 卷帘内容（仅展开时渲染） ----
                    if PluginsG.expanded == i : VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 16px;
                        spacing: 14px;
                        Rectangle { height: 1px; background: ThemeG.border; }
                        if p.id != "imagehost" : VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "ID"; font-size: 12px; color: ThemeG.text-dim; width: 76px; vertical-alignment: center; }
                                Text { text: p.id; font-size: 12px; color: ThemeG.text; vertical-alignment: center; overflow: elide; }
                            }
                            if p.author != "" : HorizontalLayout {
                                spacing: 8px;
                                Text { text: "作者"; font-size: 12px; color: ThemeG.text-dim; width: 76px; vertical-alignment: center; }
                                Text { text: p.author; font-size: 12px; color: ThemeG.text; vertical-alignment: center; overflow: elide; }
                            }
                            if p.entry != "" : HorizontalLayout {
                                spacing: 8px;
                                Text { text: "入口文件"; font-size: 12px; color: ThemeG.text-dim; width: 76px; vertical-alignment: center; }
                                Text { text: p.entry; font-size: 12px; color: ThemeG.text; vertical-alignment: center; overflow: elide; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "完整性"; font-size: 12px; color: ThemeG.text-dim; width: 76px; vertical-alignment: center; }
                                Text {
                                    text: p.verified ? "校验通过" : "校验失败";
                                    font-size: 12px;
                                    color: p.verified ? ThemeG.ok : ThemeG.err;
                                    vertical-alignment: center;
                                }
                            }
                            if !p.verified && p.status != "" : Rectangle {
                                background: ThemeG.panel-2;
                                border-radius: ThemeG.radius-s;
                                height: pstat.preferred-height + 16px;
                                pstat := Text {
                                    text: p.status;
                                    font-size: 11px;
                                    color: ThemeG.err;
                                    wrap: word-wrap;
                                    x: 10px;
                                    width: parent.width - 20px;
                                    y: 8px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "位置"; font-size: 12px; color: ThemeG.text-dim; width: 76px; vertical-alignment: center; }
                                Text { text: p.path; font-size: 11px; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; }
                            }
                            if p.kind == "package" : Text {
                                text: "启用 = 执行上面的入口文件（.msi 会以静默方式安装）。停用不会卸载已安装的程序。";
                                font-size: 11px;
                                color: ThemeG.text-dim;
                                wrap: word-wrap;
                            }
                        }
                        if p.id == "imagehost" : VerticalLayout {
                            spacing: 14px;
                            // 存储根
                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "存储根（第一项为默认根）"; font-size: 12px; font-weight: 600; color: ThemeG.text-dim; }
                                for r[ri] in PluginsG.roots : Rectangle {
                                    height: 44px;
                                    background: ThemeG.panel-2;
                                    border-radius: ThemeG.radius-s;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text { text: r.id; font-size: 12px; color: ThemeG.text-dim; width: 70px; vertical-alignment: center; }
                                        Text { text: r.remote; font-size: 13px; color: ThemeG.text; vertical-alignment: center; overflow: elide; }
                                        if r.public-template != "" : Text { text: "→ " + r.public-template; font-size: 11px; color: ThemeG.ok; vertical-alignment: center; overflow: elide; }
                                        Rectangle {}
                                        PillBtn {
                                            label: r.is-default ? "默认" : "设为默认";
                                            compact: true;
                                            primary: r.is-default;
                                            clicked => { root.root-default(ri); }
                                        }
                                        IconBtn { label: "\u{E711}"; danger: true; clicked => { root.del-root(ri); } }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    PillBtn { label: "＋ 添加根（默认第一个远程）"; clicked => { root.add-root(); } }
                                    Rectangle {}
                                    PillBtn { label: "保存图床配置"; primary: true; clicked => { root.save-config(); } }
                                }
                            }
                            // 命名与去重
                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "命名与去重"; font-size: 12px; font-weight: 600; color: ThemeG.text-dim; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;
                                    FieldLabel { text: "命名模式"; width: 70px; vertical-alignment: center; }
                                    ComboBox {
                                        width: 160px;
                                        model: PluginsG.naming;
                                        current-index <=> PluginsG.naming-idx;
                                    }
                                    FieldLabel { text: "序号补零"; width: 60px; vertical-alignment: center; }
                                    LineEdit { width: 160px; text <=> PluginsG.seq-pad; }
                                    CheckBox { checked <=> PluginsG.dedupe; text: "SHA1 去重秒传"; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;
                                    FieldLabel { text: "Obsidian 布局"; width: 90px; vertical-alignment: center; }
                                    ComboBox {
                                        width: 160px;
                                        model: PluginsG.obs;
                                        current-index <=> PluginsG.obs-idx;
                                    }
                                    FieldLabel { text: "回收站目录"; width: 70px; vertical-alignment: center; }
                                    LineEdit { text <=> PluginsG.trash-dir; placeholder-text: "留空直接删除"; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;
                                    FieldLabel { text: "公网直链模板"; width: 90px; vertical-alignment: center; }
                                    LineEdit {
                                        text <=> PluginsG.public-template;
                                        placeholder-text: "如 https://cdn.example.com/d/{path}/{filename}（teldrive）";
                                    }
                                }
                            }
                            // 访问令牌
                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "访问令牌（Bearer）"; font-size: 12px; font-weight: 600; color: ThemeG.text-dim; }
                                if PluginsG.tokens.length == 0 : Text {
                                    text: "未创建令牌（未配置时不鉴权）";
                                    font-size: 12px;
                                    color: ThemeG.text-dim;
                                }
                                for t[ti] in PluginsG.tokens : Rectangle {
                                    height: 30px;
                                    background: ThemeG.panel-2;
                                    border-radius: ThemeG.radius-s;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Text { text: t.name; font-size: 12px; color: ThemeG.text; width: 90px; vertical-alignment: center; }
                                        Text { text: t.token; font-size: 11px; font-family: "Consolas"; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; }
                                        Rectangle {}
                                        IconBtn { label: "\u{E8C8}"; clicked => { root.copy-token(t.token); } }
                                        IconBtn {
                                            label: "\u{E711}";
                                            danger: true;
                                            clicked => {
                                                root.tok-idx = ti;
                                                root.tok-name = t.name;
                                                root.pop-ax = Math.max(0px, Math.min(self.absolute-position.x - root.absolute-position.x + self.width / 2 - 160px, root.width - 324px));
                                                // 弹窗锚在按钮下方；靠近窗口底部时必须往上收，否则
                                                // 按钮会被窗口底边裁掉（实测：代理配置卡片在页面底部，
                                                // 「删除代理」的确认框只剩标题和正文，确认/取消点不到）。
                                                root.pop-ay = Math.max(0px, Math.min(self.absolute-position.y - root.absolute-position.y + self.height + 4px, root.viewport-h - 216px));
                                                tp.show();
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    Rectangle {}
                                    PillBtn { label: "＋ 新建令牌"; compact: true; clicked => { root.add-token(); } }
                                }
                            }
                            // 图床文件
                            VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    height: 28px;
                                    Text { text: "图床文件（" + PluginsG.images.length + "）"; font-size: 12px; font-weight: 600; color: ThemeG.text-dim; vertical-alignment: center; }
                                    Rectangle {}
                                    PillBtn { label: "刷新索引"; compact: true; clicked => { root.images-refresh(); } }
                                }
                                if PluginsG.images.length == 0 : Text {
                                    text: "索引为空";
                                    font-size: 12px;
                                    color: ThemeG.text-dim;
                                }
                                if PluginsG.images.length > 0 : Rectangle {
                                    height: 220px;
                                    ListView {
                                        for im[imi] in PluginsG.images : Rectangle {
                                            height: 34px;
                                            background: ta.has-hover ? ThemeG.hover : transparent;
                                            ta := TouchArea { mouse-cursor: pointer; }
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    Text { text: im.path; font-size: 12px; color: ThemeG.text; width: parent.width; overflow: elide; vertical-alignment: center; }
                                                }
                                                Text { text: im.size; font-size: 11px; color: ThemeG.text-dim; width: 70px; vertical-alignment: center; }
                                                Text { text: im.uploaded; font-size: 11px; color: ThemeG.text-dim; width: 150px; vertical-alignment: center; }
                                                IconBtn { label: "\u{E8C8}"; clicked => { root.copy-url(imi); } }
                                                IconBtn {
                                                    label: "\u{E74D}";
                                                    danger: true;
                                                    clicked => {
                                                        root.img-idx = imi;
                                                        root.img-path = im.path;
                                                        root.pop-ax = Math.max(0px, Math.min(self.absolute-position.x - root.absolute-position.x + self.width / 2 - 160px, root.width - 324px));
                                                        // 弹窗锚在按钮下方；靠近窗口底部时必须往上收，否则
                                                // 按钮会被窗口底边裁掉（实测：代理配置卡片在页面底部，
                                                // 「删除代理」的确认框只剩标题和正文，确认/取消点不到）。
                                                root.pop-ay = Math.max(0px, Math.min(self.absolute-position.y - root.absolute-position.y + self.height + 4px, root.viewport-h - 216px));
                                                        ip.show();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // 撤销令牌确认弹窗
    tp := ConfirmPop {
        title: "撤销令牌";
        msg: "确认撤销令牌 " + root.tok-name + "？";
        ok-label: "撤销";
        x: root.pop-ax;
        y: root.pop-ay;
        confirmed => { root.revoke-token(root.tok-idx); }
    }
    // 删除图床文件确认弹窗
    ip := ConfirmPop {
        title: "删除文件";
        msg: "确认删除 " + root.img-path + "？";
        x: root.pop-ax;
        y: root.pop-ay;
        confirmed => { root.image-del(root.img-idx); }
    }
}

component SettingsView inherits Rectangle {
    background: transparent;
    callback save;
    callback test;
    callback pick-exe;
    callback options-save;
    // 连接动作（阶段 3）：只影响 RC 连接，不启停 rclone 进程
    callback conn-connect;
    callback conn-disconnect;
    callback conn-reconnect;
    // 档案导入导出（阶段 5A）
    callback conf-export;
    callback conf-import-preview;
    callback conf-import-apply;
    callback conf-export-confirmed;
    callback conf-export-cancelled;
    callback script-generate;
    callback script-copy;
    // 「以管理员身份运行」：复选框切换后由 Rust 判断是否需要重启并打开确认弹层
    callback admin-toggle;
    callback admin-restart;
    callback admin-cancel;
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Card {
                title: "rclone 连接";
                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        FieldLabel { text: "RC 地址"; width: 70px; vertical-alignment: center; }
                        LineEdit { width: 300px; text <=> SettingsG.rc-url; placeholder-text: "http://127.0.0.1:5572"; }
                        FieldLabel { text: "RC 用户"; width: 56px; vertical-alignment: center; }
                        LineEdit { width: 150px; text <=> SettingsG.rc-user; }
                        FieldLabel { text: "RC 密码"; width: 56px; vertical-alignment: center; }
                        LineEdit { width: 150px; text <=> SettingsG.rc-pass; input-type: InputType.password; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        height: 26px;
                        CheckBox {
                            checked <=> SettingsG.connect-on-start;
                            text: "启动时连接该地址（只连 API，不启动 rclone）";
                            toggled => { root.save(); }
                        }
                        Text {
                            text: "RCGUI 不启动、不停止、不重启 rclone";
                            font-size: 12px;
                            color: ThemeG.text-dim;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 1px; background: ThemeG.border; }
                    // 连接状态（阶段 3）：区分「运行中 / 已断开（显示上次快照）/ 未连接」
                    HorizontalLayout {
                        spacing: 8px;
                        height: 26px;
                        // Slint 的两个对齐不要混：
                        // - `alignment` = 主轴（水平）对齐，写成 center 会把整行内容居中；
                        // - `cross-axis-alignment` = 交叉轴（垂直）对齐，用它做垂直居中。
                        // 8px 的小圆点在默认（stretch）下会被拉伸、贴顶，所以取 center。
                        cross-axis-alignment: center;
                        FieldLabel { text: "状态"; width: 46px; vertical-alignment: center; }
                        // 圆点用固定尺寸，避免被交叉轴拉伸成竖条
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: SettingsG.conn-live ? ThemeG.ok : (SettingsG.conn-stale ? ThemeG.warn : ThemeG.err);
                        }
                        Text {
                            text: SettingsG.conn-status;
                            font-size: 13px;
                            color: SettingsG.conn-live ? ThemeG.ok : (SettingsG.conn-stale ? ThemeG.warn : ThemeG.text-dim);
                            vertical-alignment: center;
                        }
                        Text {
                            text: SettingsG.conn-endpoint;
                            font-size: 12px;
                            color: ThemeG.text-dim;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 20px;
                        Text { text: "版本 " + SettingsG.conn-version; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        Text { text: "· 配置文件 " + SettingsG.conn-config-path; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                    Text {
                        text: "上次刷新 " + SettingsG.conn-last-refresh;
                        font-size: 12px;
                        color: ThemeG.text-dim;
                        vertical-alignment: center;
                    }
                    if SettingsG.conn-error != "" : Text {
                        text: SettingsG.conn-error;
                        font-size: 12px;
                        color: ThemeG.err;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        PillBtn { label: "连接 / 握手"; primary: true; disabled: SettingsG.conn-busy; clicked => { root.conn-connect(); } }
                        PillBtn { label: "断开"; disabled: SettingsG.conn-busy || !SettingsG.conn-live; clicked => { root.conn-disconnect(); } }
                        PillBtn { label: "重新握手"; disabled: SettingsG.conn-busy; clicked => { root.conn-reconnect(); } }
                        Text { text: SettingsG.conn-busy ? "正在握手…" : ""; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                    }
                }
            }
            Card {
                title: "档案导入 / 导出（rcgui.conf）";
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: SettingsG.conf-info;
                        font-size: 12px;
                        color: ThemeG.text-dim;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        PillBtn {
                            label: "导出 rcgui.conf";
                            primary: true;
                            clicked => {
                                // 勾选「包含凭据」时先要一次明确确认；未勾选直接导出
                                if (SettingsG.conf-include-secrets) {
                                    SettingsG.conf-confirm-msg = "文件将以明文包含远程凭据（OAuth token / 密码）。rclone 的 obscure 只是可逆混淆，不是加密。确认导出？";
                                    cexp.show();
                                } else {
                                    root.conf-export();
                                }
                            }
                        }
                        CheckBox {
                            checked <=> SettingsG.conf-include-secrets;
                            text: "导出时包含凭据";
                        }
                        PillBtn { label: "导入预览"; clicked => { root.conf-import-preview(); } }
                        PillBtn { label: "应用导入"; disabled: !SettingsG.conf-pending; clicked => { root.conf-import-apply(); } }
                        Text {
                            text: SettingsG.conf-pending ? "已预览，可应用" : "";
                            font-size: 12px;
                            color: ThemeG.warn;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Card {
                title: "开机恢复脚本（PowerShell）";
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "只连接已运行且启用 RC 的 rclone：先健康检查，连不上就明确退出；不启动、不停止 rclone，不注册开机项，不内置 RC 密码。生成后不会自动执行。";
                        font-size: 12px;
                        color: ThemeG.text-dim;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        PillBtn { label: "生成恢复脚本"; primary: true; clicked => { root.script-generate(); } }
                        PillBtn { label: "复制脚本"; disabled: SettingsG.script-preview == ""; clicked => { root.script-copy(); } }
                        Text {
                            text: "保存位置: " + SettingsG.script-path;
                            font-size: 12px;
                            color: ThemeG.text-dim;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    if SettingsG.script-preview != "" : Rectangle {
                        height: 240px;
                        border-radius: ThemeG.radius-s;
                        border-width: 1px;
                        border-color: ThemeG.border;
                        background: ThemeG.panel-2;
                        TextEdit {
                            read-only: true;
                            text: SettingsG.script-preview;
                            font-size: 12px;
                            wrap: no-wrap;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Card {
                    title: "外观与启动";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            FieldLabel { text: "主题"; width: 46px; vertical-alignment: center; }
                            ComboBox {
                                width: 160px;
                                model: SettingsG.themes;
                                current-index <=> SettingsG.theme-idx;
                                changed current-index => { root.save(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            height: 26px;
                            FieldLabel { text: "强调色"; width: 46px; vertical-alignment: center; }
                            for c[i] in [#1f6feb, #238636, #8957e5, #d4760a] : Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: c;
                                border-width: SettingsG.accent-idx == i ? 2px : 0px;
                                border-color: ThemeG.text;
                                ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { SettingsG.accent-idx = i; root.save(); }
                                }
                            }
                            Text { text: SettingsG.accents[SettingsG.accent-idx]; font-size: 12px; color: ThemeG.text-dim; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 20px;
                            height: 28px;
                            CheckBox { checked <=> SettingsG.autostart; text: "开机自启"; toggled => { root.save(); } }
                            CheckBox { checked <=> SettingsG.silent; text: "静默启动（仅托盘）"; toggled => { root.save(); } }
                        }
                        // 以管理员身份运行：切换即提示「软件将重启」，确认后按目标权限重启
                        HorizontalLayout {
                            spacing: 12px;
                            height: 28px;
                            CheckBox {
                                checked <=> SettingsG.run-as-admin;
                                text: "以管理员身份运行";
                                toggled => { root.admin-toggle(); }
                            }
                            Text {
                                text: "切换权限会重启软件（当前窗口先关闭）";
                                font-size: 11px;
                                color: ThemeG.text-dim;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Card {
                    title: "内嵌 HTTP 服务（图床 / 直链 / Obsidian）";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 12px;
                            height: 32px;
                            CheckBox { checked <=> SettingsG.http-enabled; text: "启用"; toggled => { root.save(); } }
                            FieldLabel { text: "端口"; width: 34px; vertical-alignment: center; }
                            LineEdit { width: 160px; text <=> SettingsG.http-port; }
                        }
                    }
                }
                Card {
                    title: "rclone 运行参数（立即生效）";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            FieldLabel { text: "Transfers"; width: 60px; vertical-alignment: center; }
                            LineEdit { width: 160px; text <=> SettingsG.opt-transfers; }
                            FieldLabel { text: "Checkers"; width: 60px; vertical-alignment: center; }
                            LineEdit { width: 160px; text <=> SettingsG.opt-checkers; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            FieldLabel { text: "TPSLimit"; width: 60px; vertical-alignment: center; }
                            LineEdit { width: 160px; text <=> SettingsG.opt-tpslimit; }
                            FieldLabel { text: "Log Level"; width: 60px; vertical-alignment: center; }
                            ComboBox { width: 160px; model: SettingsG.log-levels; current-index <=> SettingsG.log-level-idx; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            PillBtn { label: "保存运行参数"; primary: true; compact: true; clicked => { root.options-save(); } }
                            Rectangle {}
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                height: 36px;
                PillBtn { label: "保存设置"; primary: true; clicked => { root.save(); } }
                PillBtn { label: "测试连接"; clicked => { root.test(); } }
                Rectangle {}
                FieldLabel { text: "配置文件: " + SettingsG.cfg-path; vertical-alignment: center; }
            }
        }
    }
    // 导出含凭据时的二次确认：Rust 置 conf-confirm-show=true 触发；取消/确认先 close() 再回调 Rust 清理状态。
    cexp := ConfirmPop {
        title: "导出包含凭据？";
        msg: SettingsG.conf-confirm-msg;
        ok-label: "确认导出";
        confirmed => { root.conf-export-confirmed(); }
        cancelled => { root.conf-export-cancelled(); }
    }
    // 切换「以管理员身份运行」的确认弹层。
    // 不用 PopupWindow：CheckBox 的 toggled 发生在同一次点击里，弹出窗口会被
    // “点击外部关闭”立刻取消；改用页面内模态覆盖层，行为确定且可测。
    if SettingsG.admin-confirm-show : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000055;
        // 吃掉点击，避免穿透到下层控件
        TouchArea { clicked => { } }
        Rectangle {
            width: 380px;
            height: 176px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: ThemeG.panel;
            border-radius: ThemeG.radius;
            border-width: 1px;
            border-color: ThemeG.border;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text { text: "软件将重启"; font-size: 15px; font-weight: 700; color: ThemeG.text; }
                Text {
                    text: SettingsG.admin-confirm-msg;
                    font-size: 13px;
                    color: ThemeG.text-dim;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    PillBtn {
                        label: "取消";
                        clicked => {
                            SettingsG.admin-confirm-show = false;
                            root.admin-cancel();
                        }
                    }
                    PillBtn {
                        label: "确定";
                        primary: true;
                        clicked => {
                            SettingsG.admin-confirm-show = false;
                            root.admin-restart();
                        }
                    }
                }
            }
        }
    }
}

// ---------------- 自定义标题栏（无边框窗口） ----------------

/// 应用标记：圆角方块 + 云朵 + 终端提示符。
///
/// 为什么用矢量而不是图片：
/// - 需要**跟随强调色**变化（图片做不到，除非准备多套）；
/// - 需要多个尺寸（标题栏 18px、托盘 32px 等），矢量在任意尺寸都清晰。
///
/// 实现约束（Slint 1.x 踩坑记录）：
/// - `Rectangle` **没有** `transform` 属性，不能旋转，所以「>」不能靠旋转矩形画；
/// - `Path` 的 `MoveTo/LineTo` 坐标是 float，且在其内部不能用 `self.width`
///   做比例运算（会形成绑定循环）。因此全部改用**固定尺寸 + 父级引用的比例**
///   的简单叠加，并在小尺寸下牺牲细节。
///
/// 最终造型：强调色圆角底 + 白色云（两圆一底座）+ 云内深色终端窗口。
component AppMark inherits Rectangle {
    in property <length> size: 18px;
    /// 主色；默认跟随强调色
    in property <brush> tint: ThemeG.accent;
    width: root.size;
    height: root.size;
    background: root.tint;
    border-radius: root.size * 0.24;

    // 云朵：左圆 + 右大圆 + 底部横条，叠出云形轮廓
    Rectangle {
        x: root.size * 0.14;
        y: root.size * 0.32;
        width: root.size * 0.42;
        height: root.size * 0.42;
        border-radius: self.width / 2;
        background: white;
    }
    Rectangle {
        x: root.size * 0.38;
        y: root.size * 0.20;
        width: root.size * 0.50;
        height: root.size * 0.50;
        border-radius: self.width / 2;
        background: white;
    }
    Rectangle {
        x: root.size * 0.14;
        y: root.size * 0.52;
        width: root.size * 0.74;
        height: root.size * 0.22;
        border-radius: self.height / 2;
        background: white;
    }
    // 云内的终端窗口：用主色「挖」出来
    Rectangle {
        x: root.size * 0.30;
        y: root.size * 0.44;
        width: root.size * 0.46;
        height: root.size * 0.34;
        border-radius: root.size * 0.07;
        background: root.tint;
        // 终端内容：用 Text 画 ">_"（比 Path 稳，且任意尺寸可读）。
        // font-size 必须引用**外层** root.size，不能用 self.width：
        // 那会让 font-size -> preferred-width -> width -> font-size 形成循环。
        Text {
            text: ">_";
            font-size: root.size * 0.26;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// 标题栏上的窗口按钮（最小化 / 最大化 / 关闭）
component WinBtn inherits Rectangle {
    in property <string> glyph: "";
    in property <bool> danger: false;
    callback act;
    width: 46px;
    height: 100%;
    background: ta.has-hover ? (root.danger ? ThemeG.err : ThemeG.hover) : transparent;
    Text {
        text: root.glyph;
        font-family: "Segoe MDL2 Assets";
        font-size: 10px;
        color: ta.has-hover && root.danger ? white : ThemeG.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.act(); }
    }
}

/// 自绘标题栏：隐藏系统边框后由它承担拖动 / 双击最大化 / 窗口按钮。
/// 拖动交给 WindowMoveArea（winit 原生实现），比自己算坐标更稳。
component TitleBar inherits Rectangle {
    in property <bool> is-maximized: false;
    callback minimize;
    callback toggle-maximize;
    callback close-window;

    height: 36px;
    background: ThemeG.panel;

    // 可拖拽区域（右侧 138px 留给窗口按钮）
    WindowMoveArea {
        x: 0;
        y: 0;
        width: parent.width - 138px;
        height: parent.height;
        // 双击标题栏切换最大化。作为子元素不会抢走拖动（官方文档保证的用法）
        TouchArea {
            double-clicked => { root.toggle-maximize(); }
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        spacing: 8px;
        // ⚠️ 注意 Slint 里两个「对齐」是完全不同的东西：
        // - `alignment` 是**主轴**（这里=水平）对齐。写成 center 会把图标和标题
        //   推到标题栏中间 —— 这正是之前「图标不在左侧」的原因。
        // - `cross-axis-alignment` 才是**交叉轴**（这里=垂直）对齐，用它做垂直居中。
        // 所以：主轴保持默认（stretch → 内容留在左侧），交叉轴取 center。
        cross-axis-alignment: center;
        // 应用图标：用矢量方式画（与托盘/窗口图标同一套造型），
        // 颜色跟随强调色，缩放与主题切换都不会糊。
        AppMark { size: 18px; }
        Text {
            text: "RCGUI";
            font-size: 12px;
            font-weight: 600;
            color: ThemeG.text;
            vertical-alignment: center;
        }
        Rectangle {}
    }

    HorizontalLayout {
        x: parent.width - 138px;
        width: 138px;
        height: 100%;
        WinBtn { glyph: "\u{E921}"; act => { root.minimize(); } }
        WinBtn { glyph: root.is-maximized ? "\u{E923}" : "\u{E922}"; act => { root.toggle-maximize(); } }
        WinBtn { glyph: "\u{E8BB}"; danger: true; act => { root.close-window(); } }
    }
}

// ---------------- 主窗口 ----------------

export component MainWindow inherits Window {
    title: "RCGUI";
    // 隐藏系统边框，改用自绘标题栏，使标题栏与整体 UI 风格一致。
    // resize-border-width 让窗口四边仍可拖拽缩放（winit 原生处理）。
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 940px;
    min-height: 600px;
    background: ThemeG.bg;

    property <[string]> page-names: ["仪表盘", "文件", "远程", "挂载", "服务", "传输", "插件", "设置"];
    property <[string]> nav-icons: ["\u{E80F}", "\u{E8B7}", "\u{E753}", "\u{E8CE}", "\u{E909}", "\u{E895}", "\u{EA86}", "\u{E713}"];

    callback refresh-dashboard();
    callback nav-select(int);
    callback files-refresh();
    callback files-open(int);
    callback files-up();
    callback files-mkdir();
    callback files-del(int);
    callback files-rename(int);
    callback files-copy(int);
    callback files-copy-link(int);
    callback mounts-refresh();
    callback mount-add();
    callback mount-remove(string);
    callback mount-path-nav(string);
    callback mounts-search(string);
    callback serve-path-nav(string);
    callback serves-search(string);
    callback browse-open(int);
    callback browse-goto(string);
    callback browse-ok();
    callback remotes-refresh();
    callback remotes-filter(string);
    callback remote-add();
    callback remote-edit(int);
    callback remote-del(int);
    callback remote-editor-save();
    callback remote-editor-cancel();
    callback remote-type-changed();
    // 代理
    callback proxy-changed(string, int);
    callback proxy-add();
    callback proxy-edit(string);
    callback proxy-save();
    callback proxy-cancel();
    callback proxy-del(string);
    callback proxy-del-confirm(string);
    callback proxy-refresh();
    callback serves-refresh();
    callback serve-start();
    callback serve-stop(string);
    callback transfers-refresh();
    callback hide-done-changed();
    callback transfers-task-search(string);
    callback limit-apply();
    callback job-stop(int);
    callback plugins-rescan();
    callback ih-save-config();
    callback ih-add-root();
    callback ih-del-root(int);
    callback ih-root-default(int);
    callback ih-add-token();
    callback ih-revoke-token(int);
    callback ih-images-refresh();
    callback ih-image-del(int);
    callback ih-copy-url(int);
    callback copy-text(string);
    callback settings-save();
    callback settings-test();
    callback pick-exe();
    callback options-save();
    callback conn-connect();
    callback conn-disconnect();
    callback conn-reconnect();
    callback conf-export();
    callback conf-import-preview();
    callback conf-import-apply();
    callback conf-export-confirmed();
    callback conf-export-cancelled();
    callback script-generate();
    callback script-copy();
    // 以管理员身份运行的确认（页面内弹层，见 SettingsView）
    callback admin-toggle();
    callback admin-restart();
    callback admin-cancel();
    callback plugin-toggle(int);
    callback plugin-add-from-file();
    callback plugin-add-from-dir();
    callback plugin-open-dir();
    callback show-toast(int, string);
    callback win-minimize();
    callback win-toggle-maximize();
    callback win-close();


    // 内置控件（LineEdit / ComboBox / CheckBox / TextEdit / ScrollView）的文字与背景色
    // 来自 Slint 的 Palette，而 Palette 默认只跟随**系统**明暗（SlintInternal.color-scheme），
    // 不跟随应用内的 ThemeG.dark。因此在系统为深色、应用切到浅色时，
    // 输入框文字仍是深色主题的浅色前景，看起来就是"字体颜色没有同步更改"。
    // 这里把内置控件调色板显式同步到应用主题，保证两者始终一致。
    private property <bool> palette-dark: ThemeG.dark;
    init => {
        root.refresh-dashboard();
        Palette.color-scheme = root.palette-dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed palette-dark => {
        Palette.color-scheme = root.palette-dark ? ColorScheme.dark : ColorScheme.light;
    }

    VerticalLayout {
        spacing: 0px;
        // 自绘标题栏（系统边框已隐藏）
        TitleBar {
            // Slint 的 maximized 与 winit 双向同步（含 Win+↑ / 贴靠），
            // 因此这里直接用它驱动按钮图标，无需自己维护状态
            is-maximized: root.maximized;
            minimize => { root.win-minimize(); }
            toggle-maximize => { root.win-toggle-maximize(); }
            close-window => { root.win-close(); }
        }
        Rectangle {
            height: 1px;
            background: ThemeG.border;
        }

    HorizontalLayout {
        // ---- 左侧栏 ----
        Rectangle {
            width: 64px;
            background: ThemeG.panel;
            VerticalLayout {
                padding-top: 8px;
                spacing: 2px;
                for n[i] in root.page-names : Rectangle {
                    height: 52px;
                    background: NavG.idx == i ? ThemeG.accent-soft : (ta.has-hover ? ThemeG.hover : transparent);
                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { NavG.idx = i; root.nav-select(i); }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Rectangle {
                            height: 22px;
                            Text {
                                text: root.nav-icons[i];
                                font-family: "Segoe MDL2 Assets";
                                font-size: 20px;
                                color: NavG.idx == i ? ThemeG.accent : ThemeG.text-dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                // 远程页忙碌（启动预热 / 刷新 / 应用导入 / 下发代理）：
                                // 图标位换成 spinner
                                visible: !(i == 2 && NavG.remotes-busy);
                            }
                            // 远程页忙碌：spinner 占满整个图标位
                            if i == 2 && NavG.remotes-busy : Rectangle {
                                x: 0;
                                y: 0;
                                width: 100%;
                                height: 100%;
                                HorizontalLayout {
                                    alignment: center;
                                    Spinner { width: 20px; height: 20px; running: true; }
                                }
                            }
                        }
                        Text { text: n; font-size: 9px; color: NavG.idx == i ? ThemeG.accent : ThemeG.text-dim; horizontal-alignment: center; }
                    }
                    Rectangle {
                        x: 0; width: 3px; height: 24px;
                        y: parent.height / 2 - 12px;
                        background: NavG.idx == i ? ThemeG.accent : transparent;
                        border-radius: 2px;
                    }
                }
                Rectangle {}
                Rectangle {
                    height: 56px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px; height: 10px;
                                border-radius: 5px;
                                background: DashboardG.running ? ThemeG.ok : ThemeG.err;
                            }
                        }
                        Text { text: DashboardG.running ? "在线" : "离线"; font-size: 9px; color: ThemeG.text-dim; horizontal-alignment: center; }
                    }
                }
            }
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: 100%;
                background: ThemeG.border;
            }
        }

        // ---- 主区域 ----
        VerticalLayout {
            // 顶栏
            Rectangle {
                height: 48px;
                background: ThemeG.panel;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 20px;
                    spacing: 12px;
                    SectionTitle {
                        text: root.page-names[NavG.idx];
                        vertical-alignment: center;
                    }
                    Rectangle {}
                    Rectangle {
                    width: 140px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            background: ThemeG.panel-2;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: ThemeG.border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                Text { text: "\u{E895}"; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: ThemeG.accent; vertical-alignment: center; }
                                Text { text: DashboardG.speed; font-size: 12px; font-weight: 600; color: ThemeG.accent; vertical-alignment: center; }
                            }
                        }
                    }
                }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: ThemeG.border;
                }
            }

            // 内容
            Rectangle {
                background: ThemeG.bg;
                if NavG.idx == 0 : DashboardView {
                    refresh => { root.refresh-dashboard(); }
                }
                if NavG.idx == 1 : FilesView {
                    refresh => { root.files-refresh(); }
                    open-row(i) => { root.files-open(i); }
                    go-up => { root.files-up(); }
                    mkdir => { root.files-mkdir(); }
                    del-row(i) => { root.files-del(i); }
                    rename-row(i) => { root.files-rename(i); }
                    copy-row(i) => { root.files-copy(i); }
                    copy-link(i) => { root.files-copy-link(i); }
                }
                if NavG.idx == 2 : RemotesView {
                    viewport-h: root.height;
                    refresh => { root.remotes-refresh(); }
                    filter-changed(t) => { root.remotes-filter(t); }
                    add => { root.remote-add(); }
                    edit-row(i) => { root.remote-edit(i); }
                    del-row(i) => { root.remote-del(i); }
                    editor-save => { root.remote-editor-save(); }
                    editor-cancel => { root.remote-editor-cancel(); }
                    type-changed => { root.remote-type-changed(); }
                    proxy-changed(name, idx) => { root.proxy-changed(name, idx); }
                    proxy-add => { root.proxy-add(); }
                    proxy-edit(id) => { root.proxy-edit(id); }
                    proxy-save => { root.proxy-save(); }
                    proxy-cancel => { root.proxy-cancel(); }
                    proxy-del(id) => { root.proxy-del(id); }
                    proxy-del-confirm(id) => { root.proxy-del-confirm(id); }
                    proxy-refresh => { root.proxy-refresh(); }
                }
                if NavG.idx == 3 : MountsView {
                    refresh => { root.mounts-refresh(); }
                    add => { root.mount-add(); }
                    remove(mp) => { root.mount-remove(mp); }
                    browse => { root.browse-open(0); }
                    path-nav(n) => { root.mount-path-nav(n); }
                    search-changed(t) => { root.mounts-search(t); }
                }
                if NavG.idx == 4 : ServesView {
                    refresh => { root.serves-refresh(); }
                    start => { root.serve-start(); }
                    stop(id) => { root.serve-stop(id); }
                    browse => { root.browse-open(1); }
                    path-nav(n) => { root.serve-path-nav(n); }
                    search-changed(t) => { root.serves-search(t); }
                }
                if NavG.idx == 5 : TransfersView {
                    refresh => { root.transfers-refresh(); }
                    hide-done-changed => { root.hide-done-changed(); }
                    task-search(t) => { root.transfers-task-search(t); }
                    limit-apply() => { root.limit-apply(); }
                    job-stop(id) => { root.job-stop(id); }
                }
                if NavG.idx == 6 : PluginsView {
                    viewport-h: root.height;
                    rescan => { root.plugins-rescan(); }
                    save-config => { root.ih-save-config(); }
                    add-root => { root.ih-add-root(); }
                    del-root(i) => { root.ih-del-root(i); }
                    root-default(i) => { root.ih-root-default(i); }
                    add-token => { root.ih-add-token(); }
                    revoke-token(i) => { root.ih-revoke-token(i); }
                    copy-token(t) => { root.copy-text(t); }
                    images-refresh => { root.ih-images-refresh(); }
                    image-del(i) => { root.ih-image-del(i); }
                    copy-url(i) => { root.ih-copy-url(i); }
                    plugin-toggle(i) => { root.plugin-toggle(i); }
                    add-from-file => { root.plugin-add-from-file(); }
                    add-from-dir => { root.plugin-add-from-dir(); }
                    open-dir => { root.plugin-open-dir(); }
                }
                if NavG.idx == 7 : SettingsView {
                    save => { root.settings-save(); }
                    test => { root.settings-test(); }
                    pick-exe => { root.pick-exe(); }
                    options-save => { root.options-save(); }
                    conn-connect => { root.conn-connect(); }
                    conn-disconnect => { root.conn-disconnect(); }
                    conn-reconnect => { root.conn-reconnect(); }
                    conf-export => { root.conf-export(); }
                    conf-import-preview => { root.conf-import-preview(); }
                    conf-import-apply => { root.conf-import-apply(); }
                    conf-export-confirmed => { root.conf-export-confirmed(); }
                    conf-export-cancelled => { root.conf-export-cancelled(); }
                    script-generate => { root.script-generate(); }
                    script-copy => { root.script-copy(); }
                    admin-toggle => { root.admin-toggle(); }
                    admin-restart => { root.admin-restart(); }
                    admin-cancel => { root.admin-cancel(); }
                }
            }

            // 状态栏
            Rectangle {
                height: 26px;
                background: ThemeG.panel;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 16px;
                    Text { text: DashboardG.url; font-size: 11px; color: ThemeG.text-dim; vertical-alignment: center; overflow: elide; }
                    Rectangle {}
                    // 状态栏三项都可点击（鼠标变手形以提示可点）：
                    // - 传输 / 挂载 → 跳到对应导航页
                    // - 错误       → 从底部弹出错误面板
                    // 注意：TouchArea 必须明确给出宽高，否则命中区域为 0，点了没反应。
                    TouchArea {
                        mouse-cursor: pointer;
                        width: 68px;
                        height: 22px;
                        clicked => { NavG.idx = 5; }   // 传输
                        Text { text: "传输 " + DashboardG.transfers; font-size: 11px; color: ThemeG.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        width: 68px;
                        height: 22px;
                        clicked => { NavG.idx = 3; }   // 挂载
                        Text { text: "挂载 " + DashboardG.mounts; font-size: 11px; color: ThemeG.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        width: 68px;
                        height: 22px;
                        clicked => { ToastG.error-panel = !ToastG.error-panel; }
                        Text { text: "错误 " + DashboardG.errors; font-size: 11px; color: DashboardG.errors > 0 ? ThemeG.err : ThemeG.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: ThemeG.border;
                }
            }
        }
    }
    }

    // 错误面板：点底部「错误」从下方滑出。
    // 只显示 kind == "2"（错误）的历史，避免把成功提示也混进来。
    if ToastG.error-panel : Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: 260px;
        background: ThemeG.panel;
        border-width: 1px;
        border-color: ThemeG.err;
        // 顶部圆角只在视觉上近似（Slint 不支持单边圆角，这里给整体小圆角）
        border-radius: ThemeG.radius;
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                height: 26px;
                Text {
                    text: "错误记录";
                    font-size: 14px;
                    font-weight: 700;
                    color: ThemeG.err;
                    vertical-alignment: center;
                }
                Text {
                    text: "（共 " + ToastG.history.length + " 条历史中的错误）";
                    font-size: 11px;
                    color: ThemeG.text-dim;
                    vertical-alignment: center;
                }
                Rectangle {}
                PillBtn {
                    label: "清空";
                    compact: true;
                    clicked => {
                        ToastG.history = [];
                        ToastG.has-errors = false;
                        ToastG.error-panel = false;
                    }
                }
                PillBtn {
                    label: "关闭";
                    compact: true;
                    clicked => { ToastG.error-panel = false; }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: ThemeG.radius-s;
                background: ThemeG.panel-2;
                border-width: 1px;
                border-color: ThemeG.border;
                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        // 历史里只要错误项（kind == "2"）。
                        // Slint 的 `for` 没有 filter，所以非错误项渲染成 0 高度并隐藏。
                        // 行高用固定值：在 `height` 里引用同级的 `eline` 会有求值顺序问题。
                        for l in ToastG.history : Rectangle {
                            height: l.kind == "2" ? 20px : 0px;
                            visible: l.kind == "2";
                            HorizontalLayout {
                                spacing: 8px;
                                eline := Text {
                                    text: l.time + "   " + l.msg;
                                    font-size: 12px;
                                    color: ThemeG.err;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if !ToastG.has-errors : Text {
                            text: "暂无错误记录";
                            font-size: 12px;
                            color: ThemeG.text-dim;
                        }
                    }
                }
            }
        }
    }

    // Toast
    if ToastG.show : Rectangle {
        x: parent.width / 2 - self.width / 2;
        // 错误面板打开时上移，避免被面板盖住
        y: parent.height - (ToastG.error-panel ? 284px : 64px);
        width: tmsg.preferred-width + 36px;
        height: 38px;
        border-radius: 19px;
        background: ThemeG.dark ? #21262df2 : #24292ff0;
        border-width: 1px;
        border-color: ThemeG.border;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            tmsg := Text {
                text: ToastG.msg;
                font-size: 13px;
                color: ToastG.kind == 2 ? ThemeG.err : (ToastG.kind == 1 ? ThemeG.ok : white);
                vertical-alignment: center;
            }
        }
    }

    // 远程路径浏览弹窗
    if BrowseG.show : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000066;
        TouchArea {}  // 拦截底层点击
        Rectangle {
            x: parent.width / 2 - self.width / 2;
            y: parent.height / 2 - self.height / 2;
            width: 520px;
            height: 480px;
            background: ThemeG.bg;
            border-radius: ThemeG.radius;
            border-width: 1px;
            border-color: ThemeG.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;
                    Text { text: "浏览远程路径"; font-size: 14px; font-weight: 700; color: ThemeG.text; vertical-alignment: center; }
                    Rectangle {}
                    IconBtn {
                        label: "\u{E72B}";  // 上级
                        clicked => { root.browse-goto(".."); }
                    }
                }
                Rectangle {
                    height: 30px;
                    background: ThemeG.panel-2;
                    border-radius: ThemeG.radius-s;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text { text: BrowseG.path; font-size: 12px; color: ThemeG.text-dim; overflow: elide; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: ThemeG.radius;
                    border-width: 1px;
                    border-color: ThemeG.border;
                    clip: true;
                    if BrowseG.entries.length == 0 : Text {
                        text: "（空）";
                        font-size: 13px;
                        color: ThemeG.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if BrowseG.entries.length > 0 : ListView {
                        for e[i] in BrowseG.entries : Rectangle {
                            height: 32px;
                            background: BrowseG.sel == i ? ThemeG.accent.with-alpha(0.25) : (rta.has-hover ? ThemeG.hover : transparent);
                            rta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { BrowseG.sel = i; }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text { text: e.is-dir ? "\u{E8B7}" : "\u{E8A5}"; font-size: 13px; color: e.is-dir ? ThemeG.accent : ThemeG.text-dim; width: 18px; vertical-alignment: center; }
                                Text { text: e.name; font-size: 13px; color: ThemeG.text; overflow: elide; vertical-alignment: center; }
                                Rectangle {}
                                if e.is-dir : IconBtn {
                                    label: "\u{E838}";
                                    clicked => { root.browse-goto(e.name); }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: ThemeG.border;
                                opacity: 0.4;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    alignment: end;
                    PillBtn { label: "取消"; clicked => { BrowseG.show = false; } }
                    PillBtn { label: "确定"; primary: true; clicked => { root.browse-ok(); } }
                }
            }
        }
    }
}
